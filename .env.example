# =============================================================================
# MANUFACTURING ERP ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vercel / Next.js)
# -----------------------------------------------------------------------------
# For local development: http://localhost:3001
# For production (Render / Railway backend URL): https://manufacturing-erp-backend.onrender.com
NEXT_PUBLIC_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Render / Railway / NestJS)
# -----------------------------------------------------------------------------
# Port for the NestJS HTTP server (Render/Railway sets PORT automatically)
PORT=3001

# Allowed Frontend URLs for CORS (comma-separated list for multi-domain support)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app,https://your-custom-domain.com
FRONTEND_URL="http://localhost:3000,https://manufacturing-erp.vercel.app"

# -----------------------------------------------------------------------------
# 3. DATABASE CONNECTION (Prisma ORM)
# -----------------------------------------------------------------------------
# SQLite (Local Development Only - cloud ephemeral filesystems will wipe data on restart):
# DATABASE_URL="file:./dev.db"
#
# PostgreSQL (Production on Render, Railway, Neon, Supabase, or Docker):
DATABASE_URL="postgresql://erp_user:securepassword@localhost:5432/manufacturing_erp?schema=public"

# -----------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET="manufacturing_erp_super_secure_jwt_secret_key_2026"
JWT_EXPIRES_IN="24h"
BCRYPT_SALT_ROUNDS=10
