  @@index([taxType])
  @@index([paymentStatus])
  @@index([approvalStatus])
  @@map("tax_records")
}

// =========================================================================
// ENGINEERING, MACHINERY AND ELECTRONICS / CABLE WIRE SPECIALIZED MODELS
// =========================================================================

// 
// 1. Wire Drawing & Continuous Annealing Telemetry
// Governed by WIRE_DRAWING_ANNEALING_MANAGER:
// - Wire elongation ratio tracking
// - Drawing die inventory & wear monitoring
// - Weight reduction yield recording
// - Continuous annealing temperature profile logging
//
model WireDrawingAnnealingLog {
  id                          String    @id @default(uuid())
  logNumber                   String    @unique // e.g. "WDA-LOG-2026-001"
  machineId                   String    // e.g. "Rod Breakdown Machine RBM-01 (13 Dies)"
  conductorMaterial           String    @default("COPPER") // COPPER (EC Grade), ALUMINIUM (EC Grade), ALLOY
  inletDiameterMm             Float     // e.g. 8.0 mm copper rod
  outletDiameterMm            Float     // e.g. 1.8 mm drawn wire
  wireElongationRatio         Float     // Percentage elongation e.g. 28.5%
  drawingDieSetId             String    // e.g. "DIE-SET-PCD-08" (Polycrystalline Diamond)
  dieWearMicrons              Float     @default(0.0) // Die orifice wear variance in microns
  dieInventoryStatus          String    @default("OPTIMAL") // OPTIMAL, RE-POLISH_DUE, WORN_OUT, RETIRED
  inletWeightKg               Float     // e.g. 5200.0 kg
  outletWeightKg              Float     // e.g. 5148.0 kg
  weightReductionYieldPct     Float     // e.g. 99.0%
  annealingCurrentAmps        Float     // e.g. 450.0 A
  annealingVoltageVolts       Float     // e.g. 42.0 V
  annealingTempCelsius        Float     // Continuous annealer chamber temp e.g. 480.0 °C
  lineSpeedMpm                Float     // Drawing line speed e.g. 1200.0 m/min
  shiftType                   String    @default("SHIFT_A") // SHIFT_A, SHIFT_B, SHIFT_C
  status                      String    @default("RUNNING") // RUNNING, STABILIZED, DIE_CHANGEOVER, MAINTENANCE
  operatorNotes               String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([logNumber])
  @@index([conductorMaterial])
  @@index([drawingDieSetId])
  @@map("wire_drawing_annealing_logs")
}

// 
// 2. Conductor Bunching & Stranding Lay Control
// Governed by BUNCHING_STRANDING_MANAGER:
// - Conductor strand combination management
// - Machine RPM and lay-length parameter tracking
// - Bobbin/spool allocation scheduling
// - Copper/aluminium scrap loss monitoring
//
model BunchingStrandingLog {
  id                          String    @id @default(uuid())
  logNumber                   String    @unique // e.g. "BNCH-LOG-2026-001"
  machineId                   String    // e.g. "Double Twist Buncher DTB-630" or "Rigid Strander 19-Wire"
  strandingType               String    @default("BUNCHING") // BUNCHING, CONCENTRIC_STRANDING, COMPACTED_CONDUCTOR
  conductorMaterial           String    @default("COPPER") // COPPER, ALUMINIUM
  strandCount                 Int       // e.g. 7, 19, 37, 61 strands
  singleStrandDiameterMm      Float     // e.g. 0.30 mm
  conductorNominalAreaSqMm    Float     // e.g. 2.5 sq.mm, 4.0 sq.mm, 16 sq.mm
  machineRpm                  Float     // e.g. 2400.0 RPM
  layLengthMm                 Float     // e.g. 45.0 mm
  layDirection                String    @default("S_LAY") // S_LAY (Left-hand), Z_LAY (Right-hand)
  bobbinAllocationId          String    // e.g. "BOBBIN-SET-B400-12"
  scrapLossWeightKg           Float     @default(0.0) // Copper/Aluminium fine shaving/tangle scrap
  scrapLossPercentage         Float     @default(0.0) // Scrap % against throughput
  shiftOutputMeters           Float     // Total stranded conductor length in meters
  shiftOutputKg               Float     // Total stranded conductor weight in kg
  status                      String    @default("RUNNING") // RUNNING, COMPACTING, CHANGEOVER, COMPLETED
  operatorNotes               String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([logNumber])
  @@index([strandingType])
  @@index([conductorNominalAreaSqMm])
  @@map("bunching_stranding_logs")
}

// 
// 3. Extrusion Insulation & Outer Sheathing
// Governed by INSULATION_SHEATHING_MANAGER:
// - Multi-zone barrel temperature monitoring
// - Compound consumption tracking (PVC/XLPE pellets)
// - Caterpillar haul-off speed control
// - Online outer diameter (OD) laser gauge oversight
//
model InsulationSheathingLog {
  id                          String    @id @default(uuid())
  logNumber                   String    @unique // e.g. "EXTR-SHT-2026-001"
  extrusionLineId             String    // e.g. "Extruder Line 90mm (High Speed XLPE/PVC)"
  cableSpecification          String    // e.g. "3C x 2.5 sq.mm Cu/XLPE/PVC Cable", "1C x 16 sq.mm PVC Wire"
  insulationOrSheathLayer     String    @default("INSULATION") // INSULATION, INNER_SHEATH, OUTER_SHEATH
  compoundType                String    @default("XLPE") // PVC_TYPE_A, PVC_ST2, XLPE, ZHFR, HDPE
  compoundLotNumber           String    // Compound batch/lot identifier
  compoundConsumptionKg      Float     // Total polymer pellet weight consumed
  barrelZone1TempCelsius      Float     // e.g. 150.0 °C
  barrelZone2TempCelsius      Float     // e.g. 165.0 °C
  barrelZone3TempCelsius      Float     // e.g. 175.0 °C
  barrelZone4TempCelsius      Float     // e.g. 185.0 °C
  crossheadTempCelsius        Float     // e.g. 190.0 °C
  dieHeadTempCelsius          Float     // e.g. 195.0 °C
  caterpillarHaulOffSpeedMpm  Float     // Haul-off speed in m/min e.g. 85.0 m/min
  screwRpm                    Float     // Extruder screw speed e.g. 42.5 RPM
  measuredOuterDiameterMm     Float     // Online laser gauge live reading e.g. 8.42 mm
  targetOuterDiameterMm       Float     // Target specified nominal OD e.g. 8.40 mm
  laserGaugeDeviationMm       Float     @default(0.0) // Difference e.g. +0.02 mm
