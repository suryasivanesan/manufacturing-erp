// 
// 5. High-Voltage Spark Testing & QA Certification
// Governed by HV_SPARK_TESTING_QA_MANAGER:
// - Spark test fault count recording
// - Conductor DC resistance value logging
// - Quality clearance certificate issuance
// - Meter-marking calibration record management
//
model HvSparkTestingQaRecord {
  id                                String    @id @default(uuid())
  certificateNumber                 String    @unique // e.g. "QA-SPARK-2026-001"
  drumOrSpoolNumber                 String    // e.g. "DRUM-WD-2026-8812"
  cableSpecification                String    // e.g. "4 Core x 16 sq.mm XLPE Insulated Armoured Cable"
  cableLengthMeters                 Float     // e.g. 1000.0 meters
  testSpeedMpm                      Float     // Line spark speed e.g. 150.0 m/min
  appliedSparkVoltageKv             Float     // High frequency / DC test voltage e.g. 10.0 kV
  sparkFaultCount                   Int       @default(0) // Fault puncture pinhole count
  faultLocationsMeterMarks          String?   // Pin-point meter marks e.g. "412m, 825m" or "NONE"
  conductorDcResistanceOhmPerKm     Float     // Measured conductor resistance at 20°C
  maxPermittedResistanceOhmPerKm    Float     // Statutory max threshold e.g. 1.15 Ohm/km (IS 8130)
  meterMarkingInitial               Float     // e.g. 0.0 m
