// - Drying chamber temperature monitoring (Vacuum dryer / toggling)
// - Crust leather batch classification & area logging
//
model RetanningDyeingCrustLog {
  id                        String    @id @default(uuid())
  batchCode                 String    @unique // e.g. "RDC-2026-101"
  wetBlueLotNumber          String    // Referenced wet-blue lot e.g. "WBL-2026-8812"
  leatherArticle            String    // "UPPER_LEATHER", "LINING", "UPHOLSTERY", "GARMENT_SUEDE"
  dyeRecipeCode             String    // Dye recipe e.g. "REC-DYE-BURGUNDY-2026"
  targetShade               String    // e.g. "Pantone 19-1617 Deep Burgundy"
  fatliquorComposition     String    // e.g. "Synthetic + Sulfited Fish Oil 8%"
  retanningAgentsUsed       String    // e.g. "Mimosa + Quebracho + Syntans 12%"
  drumTempCelsius           Float     // Processing bath temperature e.g. 50.0°C
  dyePenetrationStatus      String    @default("FULL_PENETRATION") // "FULL_PENETRATION", "SURFACE_LEVEL", "INCOMPLETE_PENETRATION"
  dryingMethod              String    // "VACUUM_DRYING", "TOGGLING", "HANG_AIR_DRYING"
  dryingChamberTempCelsius  Float     // e.g. 65.0°C
