// 
// 5. Tax Configuration & Super Admin Payment Approval Records
// Configures corporate tax, GST, TDS, advance taxes and enforces Super Admin authorization
//
model TaxRecord {
  id                    String    @id @default(uuid())
  recordNumber          String    @unique // e.g. "TAX-REC-2026-Q3-01"
  taxType               String    @default("GST") // GST, CORPORATE_TAX, TDS, ADVANCE_TAX, CUSTOMS_DUTY
  fiscalPeriod          String    // e.g. "2026-Q3", "2026-11"
  taxableAmount         Float     @default(0.0)
  taxRatePercentage     Float     @default(18.0)
  taxAmount             Float     @default(0.0) // Total calculated tax liability
  taxDetails            String?   // Breakdown: CGST, SGST, IGST, input tax credit adjustments
  dueDate               DateTime?
  paymentStatus         String    @default("PENDING") // PENDING, PAID, OVERDUE, PARTIAL
  approvalStatus        String    @default("PENDING") // PENDING, APPROVED, REJECTED (Super Admin permission required)
  approvedBySuperAdmin  Boolean   @default(false)
  approvedById          String?
  approvedByName        String?
  approvedAt            DateTime?
  paidAt                DateTime?
  challanReference      String?   // e.g. "CIN-HDFC-9928172635"
  notes                 String?

