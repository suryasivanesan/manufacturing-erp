  glossLusterGu               Float     // Photometric gloss meter reading @ 60° e.g. 35.0 GU
  targetGlossGu               Float     // Target spec e.g. 35.0 GU
  colorFastnessRubCycles      Int       // Veslic wet/dry rub test cycles pass e.g. 1500
  hidesFinishedCount          Int       // Count of fully finished hides e.g. 120
  status                      String    @default("FINISHING_COMPLETED") // "SPRAYING", "EMBOSSING", "FINISHING_COMPLETED", "RE_BUFF_REQUIRED"
  supervisorNotes             String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

