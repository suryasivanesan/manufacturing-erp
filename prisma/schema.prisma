  totalRevenueRealized        Float?
  gatePassPassoutNumber       String?   // Outward gate pass for vehicle
  status                      String    @default("ACCUMULATING") // "ACCUMULATING", "TENDER_FLOATED", "BIDS_EVALUATED", "SOLD_DISPATCHED"
  notes                       String?

