// Core Functions:
// - Weighbridge tanker inward data logging
// - Ultrasonic milk analyzer test result integration (Fat/SNF/Density)
// - Farmer/supplier payment grading ledger management
// - Raw chilling silo inventory tracking
//
model MilkCollectionReceptionRecord {
  id                          String    @id @default(uuid())
  collectionCode              String    @unique // e.g. "MILK-REC-2026-001"
  tankerRegistrationNumber    String    // e.g. "GJ-01-DK-9412"
  supplierOrFarmerGroup       String    // e.g. "Kaira District Milk Producers Union - Route 14"
  driverName                  String?   // e.g. "Ramesh Patel"
  grossWeightKg               Float     // e.g. 24500.0 kg
  tareWeightKg                Float     // e.g. 9500.0 kg
  netWeightKg                 Float     // e.g. 15000.0 kg
  netVolumeLiters             Float     // e.g. 14563.1 L (Net Weight / Density)
  fatPercentage               Float     // Ultrasonic analyzer Fat % e.g. 4.5%
  snfPercentage               Float     // Solids-Not-Fat % e.g. 8.8%
  addedWaterPercentage        Float     @default(0.0) // Cryoscope freezing point depression added water % e.g. 0.0%
  milkDensity                 Float     // Specific gravity e.g. 1.030 g/ml
  milkTemperatureCelsius      Float     // Inward temp e.g. 4.2°C (Target: <= 4.0°C)
  paymentGradeStatus          String    @default("GRADE_A_PREMIUM") // "GRADE_A_PREMIUM", "GRADE_B_STANDARD", "CONDITIONAL_APPROVAL", "REJECTED_SOUR"
  ratePerLiterInr             Float     // e.g. 42.50 INR/L
  totalPaymentInr             Float     // e.g. 618931.75 INR
  chillingSiloId              String    // e.g. "RAW-SILO-01 (Capacity: 50,000L)"
  siloTemperatureCelsius      Float     // e.g. 3.5°C
  status                      String    @default("CHILLED_STAGED") // "UNLOADING_WEIGHING", "TESTING_ANALYSIS", "CHILLED_STAGED", "PUMPED_TO_PASTEURIZER", "REJECTED_CONTAMINATED"
  operatorNotes               String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([collectionCode])
  @@index([tankerRegistrationNumber])
  @@index([chillingSiloId])
  @@index([status])
  @@map("milk_collection_reception_records")
}

// 
// 2. PASTEURIZATION_PROCESSING_MANAGER
// Core Functions:
// - Pasteurizer temperature-time hold chart monitoring (HTST PLC logs)
// - Steam and chilled water utility consumption tracking
// - Cream separation ratio management
// - Daily processing schedule oversight
//
model PasteurizationProcessingLog {
  id                          String    @id @default(uuid())
  processingJobCode           String    @unique // e.g. "PAST-PROC-2026-101"
  productType                 String    // "STANDARDIZED_MILK", "TONED_MILK", "DOUBLE_TONED", "FULL_CREAM", "SKIMMED_MILK"
  rawMilkVolumeLtr            Float     // e.g. 10000.0 L
  pasteurizerLineId           String    // e.g. "HTST-PASTEURIZER-LINE-02 (APV Plate Heat Exchanger)"
  heatingZoneTempCelsius      Float     // e.g. 74.5°C (Target: 72.0 - 75.0°C)
  holdingTimeSeconds          Float     // e.g. 16.5 s (Minimum: 15.0 s)
  flowDiversionValveStatus    String    @default("FORWARD_FLOW") // "FORWARD_FLOW", "DIVERTED_SUB_TEMP"
  steamPressureBar            Float     // e.g. 3.2 bar
  chilledWaterTempCelsius     Float     // Cooling section exit e.g. 3.8°C
  creamSeparationYieldLtr     Float     // e.g. 420.0 L heavy cream
  creamFatPercentage          Float     // e.g. 40.5%
  standardizedMilkFatPct      Float     // e.g. 3.0% (Toned) or 4.5% (Standardized)
  homogenizationPressureBar   Float     // e.g. 180.0 bar (Stage 1: 150 bar, Stage 2: 30 bar)
  steamConsumptionKg          Float     // e.g. 450.0 kg steam
  chilledWaterKwh             Float     // e.g. 125.0 kWh
  status                      String    @default("PASTEURIZED_RELEASED") // "HEATING_RECIRCULATION", "FORWARD_FLOW_ACTIVE", "PASTEURIZED_RELEASED", "DIVERSION_ALARM_HOLD"
  operatorNotes               String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([processingJobCode])
  @@index([pasteurizerLineId])
  @@index([productType])
  @@index([status])
  @@map("pasteurization_processing_logs")
}

// 
// 3. FERMENTATION_CULTURE_MANAGER
// Core Functions:
// - Starter culture inventory and inoculation recipe management
// - Incubation chamber temperature log tracking
// - Curd pH and coagulation firmness monitoring
// - Batch yield control
//
model FermentationCultureBatch {
  id                          String    @id @default(uuid())
  fermentationBatchCode       String    @unique // e.g. "FERM-BATCH-2026-201"
  productCategory             String    // "CURD_DAHI", "GREEK_YOGURT", "PANEER_COAGULATION", "CHEDDAR_CHEESE", "PROBIOTIC_CHAAS"
  baseMilkVolumeLtr           Float     // e.g. 5000.0 L
  starterCultureStrain        String    // e.g. "Chr. Hansen DVS YF-L904 (L. bulgaricus + S. thermophilus)"
  inoculationDosageGrams      Float     // e.g. 250.0 g
  inoculationTempCelsius      Float     // Inoculation temp e.g. 42.5°C
  incubationChamberId         String    // e.g. "INCUBATION-ROOM-C3"
  incubationDurationHours     Float     // e.g. 6.5 hours
  currentCurdPh               Float     // e.g. 4.52 (Drop from 6.65)
  targetCurdPh                Float     // e.g. 4.50
  titratableAcidityPct        Float     // % Lactic acid e.g. 0.85%
  coagulationFirmnessScore    Float     // Penetrometer firmness index 1-10 e.g. 8.5
  finalCurdYieldKg            Float     // e.g. 4920.0 kg
  wheyDrainageLiters          Float     // e.g. 180.0 L
  status                      String    @default("FERMENTATION_COMPLETED") // "INOCULATION_STAGED", "INCUBATING", "COAGULATING", "FERMENTATION_COMPLETED", "HIGH_ACIDITY_ALERT"
  technicianNotes             String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([fermentationBatchCode])
  @@index([productCategory])
  @@index([status])
  @@map("fermentation_culture_batches")
}

// 
// 4. QA_MBRT_ANTIBIOTIC_INCHARGE
// Core Functions:
// - Daily microbiological and chemical test result recording (MBRT, Antibiotic residue)
// - Blocking unapproved milk batches from packaging lines
// - Certificate of Analysis (CoA) auto-generation
//
model DairyQaMbrtAntibioticRecord {
  id                          String    @id @default(uuid())
  testReportNumber            String    @unique // e.g. "MBRT-QA-2026-301"
  sampleBatchCode             String    // e.g. "PAST-PROC-2026-101"
  sampleType                  String    // "RAW_SILO_MILK", "PASTEURIZED_PACKAGED", "FERMENTED_CURD", "BULK_TANKER_INWARD"
  mbrtDecolorizationHours     Float     // Methylene Blue Reduction Test hours e.g. 5.5 hours
  mbrtQualityGrade            String    // "EXCELLENT_OVER_5H", "GOOD_3_4H", "FAIR_1_2H", "POOR_UNDER_30M"
  antibioticResidueTest       String    // "NEGATIVE_PASSED", "POSITIVE_CONTAMINATED"
  aflatoxinM1Ppb              Float     // Statutory limit: <= 0.5 ppb e.g. 0.08 ppb
  somaticCellCountPerMl       Int       // SCC e.g. 180000 cells/ml (Standard: < 400,000)
  totalColiformCountCfu       Int       // CFU/ml e.g. 0 cfu/ml in pasteurized
  packagingGateBlocked        Boolean   @default(false)
  clearanceCertificateNumber  String?   @unique // Statutory CoA e.g. "COA-DAIRY-2026-8801"
  certifiedAt                 DateTime?
  certifiedByManager          String    @default("QA_MBRT_ANTIBIOTIC_INCHARGE")
  status                      String    @default("APPROVED_FOR_PACKAGING") // "TESTING_IN_PROGRESS", "APPROVED_FOR_PACKAGING", "REJECTED_ANTIBIOTIC_HOLD", "QUARANTINED"
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([testReportNumber])
  @@index([sampleBatchCode])
  @@index([clearanceCertificateNumber])
  @@index([status])
  @@map("dairy_qa_mbrt_antibiotic_records")
}

// 
// 5. COLD_CHAIN_EXPIRY_MANAGER
// Core Functions:
// - Cold room temperature logger monitoring (2-4°C)
// - Cold-chain logistics vehicle temperature compliance management
// - Barcode label printing with strict use-by timestamps
// - Near-expiry FIFO/FEFO stock rotation
//
model ColdChainLogisticsRecord {
  id                          String    @id @default(uuid())
  dispatchTrackingCode        String    @unique // e.g. "COLD-LOG-2026-401"
  productSku                  String    // e.g. "SKU-MILK-TONED-500ML-POUCH"
  productDescription          String    // e.g. "Pasteurized Toned Milk 500ml Pouch (Pack of 24)"
  coldRoomStorageBay          String    // e.g. "COLD-ROOM-02-BAY-A"
  coldRoomTempCelsius         Float     // e.g. 3.2°C (Threshold: 2.0 - 4.0°C)
  reeferVehicleNumber         String    // e.g. "MH-12-RN-8801 (Thermo King Reefer Unit)"
  inTransitTempCelsius        Float     // e.g. 3.8°C
  tempLoggerDataLogValid      Boolean   @default(true)
  mfgTimestamp                DateTime  // Packaging timestamp e.g. 2026-11-20 04:00:00
  useByTimestamp              DateTime  // Expiry timestamp e.g. 2026-11-22 04:00:00 (48h shelf life)
  remainingShelfLifeHours     Float     // e.g. 38.5 hours
  fifoFefoStatus              String    @default("OPTIMAL_FEFO") // "OPTIMAL_FEFO", "EXPEDITE_DISPATCH", "CRITICAL_NEAR_EXPIRY", "EXPIRED_QUARANTINE"
  shippingBarcode             String    @unique // e.g. "BAR-DAIRY-FEFO-904102"
  dispatchBlocked             Boolean   @default(false)
  temperatureCompliant        Boolean   @default(true)
  dispatcherNotes             String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([dispatchTrackingCode])
  @@index([shippingBarcode])
  @@index([fifoFefoStatus])
  @@index([dispatchBlocked])
  @@map("cold_chain_logistics_records")
}

// =========================================================================
// Human Resources (HR) Department Multi-Tenant Entities (Strict Company Scope)
// =========================================================================

// 
// 1. Manpower Planning & Recruitment Record
// Functions:
// - Manpower requisition and staffing demand
// - Local hiring agency coordination
// - Skill-based technical interview status and scoring
// - Background verification (address, criminal, prior employment)
// - Joining formalities, offer releases, and onboarding
//
model HrRecruitmentRecord {
  id                          String    @id @default(uuid())
  requisitionCode             String    @unique // e.g. "HR-REQ-2026-001"
  jobTitle                    String    // e.g. "CNC Machine Operator Grade II"
  department                  String    // e.g. "PRODUCTION", "QUALITY", "MAINTENANCE"
  positionsCount              Int       @default(1)
  hiringAgency                String?   // e.g. "Apex Industrial Staffing Solutions"
  candidateName               String?   // e.g. "Rohan Patil"
  candidatePhone              String?
  candidateEmail              String?
  technicalInterviewStatus    String    @default("SCHEDULED") // "SCHEDULED", "PASSED", "REJECTED", "ON_HOLD"
  interviewScore              Float?    // Out of 10.0
  backgroundVerificationStatus String   @default("PENDING") // "PENDING", "IN_PROGRESS", "VERIFIED", "FAILED"
  joiningFormalitiesStatus    String    @default("PENDING") // "PENDING", "OFFER_RELEASED", "DOCUMENTS_SUBMITTED", "JOINED"
  joiningDate                 DateTime?
  offeredSalary               Float?
  status                      String    @default("OPEN") // "OPEN", "IN_PROCESS", "OFFERED", "HIRED", "CANCELLED"
