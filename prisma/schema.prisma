// 
// 2. Financial Metrics & Performance Analytics
// Tracks production volume, sales volume, operational expenses, raw material costs vs profit/loss
//
model FinancialMetric {
  id                 String    @id @default(uuid())
  metricCode         String    @unique // e.g. "FIN-MET-2026-11"
  period             String    @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL
  fiscalMonth        String    // e.g. "2026-11"
  productionVolume   Float     @default(0.0) // Output volume in MT / Units
  salesVolume        Float     @default(0.0) // Sales volume / units delivered
  revenue            Float     @default(0.0) // Total top-line revenue
  rawMaterialCost    Float     @default(0.0) // Total raw materials consumption cost
  laborCost          Float     @default(0.0) // Factory direct labor + departmental wages
  expenses           Float     @default(0.0) // Operational & overhead expenses
  ebitda             Float     @default(0.0) // Operating earnings
  taxExpense         Float     @default(0.0) // Tax liability provision
  profitLoss         Float     @default(0.0) // Net Profit / Loss: revenue - (rawMaterialCost + laborCost + expenses + taxExpense)
  marginPercentage   Float     @default(0.0) // Net margin %
  notes              String?

  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companyId])
  @@index([fiscalMonth])
  @@map("financial_metrics")
}

