  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([disposalCode])
  @@index([scrapType])
  @@index([status])
  @@map("scrap_disposal_managements")
}

// =========================================================================
// SALES DEPARTMENT MULTI-TENANT ENTITIES (Strict Company Isolation)
// =========================================================================

// 
// 1. Market Research, Lead Generation & Customer Acquisition
// Functions:
// - Market research and potential customer identification
// - Inquiry collection from trade fairs, digital inquiries, direct outreach
// - Pitching product catalogues and scheduling exploratory meetings
// - Lead scoring, qualification, and assignment to regional sales executives
//
model SalesLeadAcquisition {
  id                          String    @id @default(uuid())
  leadCode                    String    @unique // e.g. "LEAD-2026-101"
  clientCompanyName           String
  contactPerson               String
  contactPhone                String?
  contactEmail                String?
  leadSource                  String    // "MARKET_RESEARCH", "EXHIBITION_TRADE_FAIR", "DIRECT_INQUIRY", "PRODUCT_CATALOGUE_PITCH", "DIGITAL_PORTAL"
  industrySegment             String    // "AUTOMOTIVE_OEM", "INFRASTRUCTURE", "ELECTRONICS", "DEFENCE", "ENGINEERING"
  targetProducts              String    // e.g. "Grade EN8 Carbon Steel Billets, Forged Flanges"
  estimatedAnnualValue        Float?
  leadScore                   Float?    // 0 to 100 qualification score
  status                      String    @default("NEW_INQUIRY") // "NEW_INQUIRY", "CATALOGUE_SHARED", "MEETING_SCHEDULED", "QUALIFIED_PROSPECT", "CONVERTED_TO_RFQ", "LOST"
  assignedSalesOfficer        String?   // Regional Sales Manager / Officer
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([leadCode])
  @@index([clientCompanyName])
  @@index([industrySegment])
  @@index([status])
  @@map("sales_lead_acquisitions")
}

// 
// 2. Inquiry Processing, Quotation & Price Negotiation
// Functions:
// - Cost sheet compilation from raw material prices + machine running hours + margins
// - Commercial terms definition (Credit period days, advance %, packaging & freight charges)
// - Negotiation lifecycle management and purchase agreement finalization
//
model SalesQuotationNegotiation {
  id                          String    @id @default(uuid())
  quotationNumber             String    @unique // e.g. "QUOT-2026-088"
  inquiryReference            String?   // e.g. "INQ-2026-442"
  leadId                      String?
  clientCompanyName           String
  productDescription          String
  orderQuantity               Float
  unit                        String    @default("MT") // "MT", "PIECE", "KG", "METERS", "BOX"
  rawMaterialCost             Float     // direct bill-of-materials cost baseline
  productionOverheadCost      Float     // energy, machine wear & tooling overhead
  profitMarginPct             Float     // e.g. 15.0%
  calculatedBaseRate          Float     // cost + margin rate per unit
  finalQuotedRate             Float     // negotiated unit rate
  totalQuotationValue         Float
  creditPeriodDays            Int       @default(30)
  advancePaymentPct           Float     @default(20.0)
  deliveryChargesTerms        String    @default("EX_WORKS") // "EX_WORKS", "FOR_DESTINATION", "FOB_PORT"
  status                      String    @default("DRAFT_CALCULATED") // "DRAFT_CALCULATED", "SUBMITTED_TO_CLIENT", "UNDER_NEGOTIATION", "AGREEMENT_FINALIZED", "REJECTED"
  validTill                   DateTime?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([quotationNumber])
  @@index([clientCompanyName])
  @@index([status])
  @@map("sales_quotation_negotiations")
}

// 
// 3. Sales Order (SO) Generation & Production Coordination
// Functions:
// - Sales Order (SO) generation upon customer purchase order receipt
// - Real-time inventory & raw material availability cross-check
// - Coordination with Production Manager for delivery schedule and machine line allocation
// - Shopfloor execution progress tracking against promised dispatch date
//
model SalesOrderExecution {
  id                          String    @id @default(uuid())
  salesOrderNumber            String    @unique // e.g. "SO-2026-110"
  quotationReference          String?   // e.g. "QUOT-2026-088"
  clientPurchaseOrderNo       String    // Client official PO reference
  clientCompanyName           String
  productName                 String
  orderQuantity               Float
  unit                        String    @default("MT")
  unitRate                    Float
  totalOrderValue             Float
  inventoryStockCheckStatus   String    @default("STOCK_SUFFICIENT") // "STOCK_SUFFICIENT", "PARTIAL_STOCK", "STOCK_SHORTAGE_REQUIRING_MELT"
  productionManagerConfirmed  Boolean   @default(true)
  estimatedDeliveryDate       DateTime
  executionProgressPct        Float     @default(0.0) // 0 to 100% completion
  orderStatus                 String    @default("ORDER_CONFIRMED") // "ORDER_CONFIRMED", "IN_PRODUCTION", "QUALITY_INSPECTION", "READY_FOR_DISPATCH", "DISPATCHED", "COMPLETED"
  assignedProductionLine      String?   // e.g. "Continuous Casting & Billet Rolling Line #1"
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([salesOrderNumber])
  @@index([clientCompanyName])
  @@index([orderStatus])
  @@map("sales_order_executions")
}

// 
// 4. Dispatch Coordination & Logistics Management
// Functions:
// - Coordination with logistics providers & dedicated freight transport fleets
// - Statutory e-Way bill and Delivery Challan generation
// - Shopfloor bay loading and outward dispatch tracking
// - Real-time vehicle transit monitoring and digital Proof-of-Delivery (POD) collection
//
model SalesDispatchLogistics {
  id                          String    @id @default(uuid())
  dispatchTrackingCode        String    @unique // e.g. "DISP-LOG-2026-501"
  salesOrderNumber            String    // e.g. "SO-2026-110"
  clientCompanyName           String
  deliveryChallanNumber       String    @unique // e.g. "DC-2026-8812"
  eWayBillNumber              String?   // e.g. "EWB-991284910291"
  transporterFleetCarrier     String    // e.g. "VRL Logistics Heavy Fleet"
  vehicleNumber               String    // e.g. "MH-12-PQ-4412"
  driverNameAndContact        String?
  dispatchWeightKg            Float
  destinationLocation         String    // Client delivery address
  loadingBay                  String    // e.g. "BAY-DISP-02"
  dispatchStatus              String    @default("LOADING_IN_PROGRESS") // "LOADING_IN_PROGRESS", "DISPATCHED_IN_TRANSIT", "DELIVERED_POD_RECEIVED", "RETURNED"
  proofOfDeliveryReceived     Boolean   @default(false)
  dispatchedAt                DateTime?
  deliveredAt                 DateTime?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([dispatchTrackingCode])
  @@index([salesOrderNumber])
  @@index([dispatchStatus])
  @@map("sales_dispatch_logistics")
}

// 
// 5. Credit Control, Invoicing & Payment Collection
// Functions:
// - Commercial tax invoice generation linked to dispatch delivery challan
// - Dealer / Client credit limit oversight and approval
// - Payment due date tracking and automated escalation follow-ups
// - Ledger reconciliation and payment settlement recording
//
model SalesCreditBilling {
  id                          String    @id @default(uuid())
  invoiceNumber               String    @unique // e.g. "INV-SLS-2026-901"
  salesOrderNumber            String    // e.g. "SO-2026-110"
  deliveryChallanNumber       String?
  clientCompanyName           String
  clientGstNumber             String?
  totalInvoiceAmount          Float
  taxAmount                   Float     // 18% GST component
  netPayableAmount            Float
  dealerCreditLimit           Float     // Total approved credit limit
  outstandingBalance          Float     // Consumed credit balance
  paymentDueDate              DateTime
  paymentStatus               String    @default("PAYMENT_DUE") // "PAYMENT_DUE", "PARTIALLY_PAID", "FULLY_SETTLED", "OVERDUE_ESCALATED"
  paidAmount                  Float     @default(0.0)
  paymentReferenceUTR         String?   // Bank wire UTR
  lastFollowUpDate            DateTime?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([invoiceNumber])
  @@index([salesOrderNumber])
  @@index([clientCompanyName])
  @@index([paymentStatus])
  @@map("sales_credit_billings")
}

// 
// 6. Customer Relationship Management (CRM) & Feedback
// Functions:
// - Customer complaint ticket generation and issue classification
// - Defect / rejection handling with QA & warranty replacement coordination
// - Product improvement suggestions feed into Production/R&D
// - Periodic customer satisfaction scoring (CSAT)
//
model SalesCustomerFeedback {
  id                          String    @id @default(uuid())
  ticketNumber                String    @unique // e.g. "CRM-TKT-2026-042"
  clientCompanyName           String
  salesOrderNumber            String?
  invoiceNumber               String?
  feedbackType                String    // "CUSTOMER_COMPLAINT", "PRODUCT_REJECTION", "WARRANTY_CLAIM", "PRODUCT_IMPROVEMENT_FEEDBACK", "SERVICE_RATING"
  issueDescription            String
  severityLevel               String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  rejectedQuantity            Float?
  unit                        String?
  qualityReplacementApproved  Boolean   @default(false)
  replacementOrderCode        String?
  resolutionStatus            String    @default("OPEN_INVESTIGATING") // "OPEN_INVESTIGATING", "UNDER_QA_ANALYSIS", "REPLACEMENT_DISPATCHED", "RESOLVED_CLOSED"
  customerRating              Float?    // 1.0 to 5.0 stars
  capaActionPlan              String?   // Corrective and Preventive Action plan
  resolvedAt                  DateTime?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([ticketNumber])
  @@index([clientCompanyName])
  @@index([feedbackType])
  @@index([resolutionStatus])
  @@map("sales_customer_feedbacks")
}

// =========================================================================
// LOGISTICS DEPARTMENT MULTI-TENANT ENTITIES (Strict Company Isolation)
// =========================================================================

// 
// 1. Inbound Logistics & Raw Material Transport
// Functions:
// - Tracking raw material transit from supplier works to factory gate
// - Scheduling arrival slots to prevent gate congestion
// - Monitoring transit delays, weather, route diversions
// - Procurement pickup fleet coordination
//
model LogisticsInboundTransport {
  id                          String    @id @default(uuid())
  trackingCode                String    @unique // e.g. "INB-TRK-2026-101"
  vendorSupplierName          String
  purchaseOrderRef            String?   // e.g. "PO-2026-089"
  materialCategory            String    // "RAW_MATERIALS", "CONSUMABLES", "SPARE_PARTS"
  transporterFleet            String    // e.g. "VRL Logistics Heavy Freight"
  vehicleNumber               String    // e.g. "MH-12-RN-9921"
  driverNameAndContact        String?
  inboundWeightKg             Float
  originLocation              String    // e.g. "Jamshedpur Steel Works, Jharkhand"
  scheduledArrivalDate        DateTime
  actualArrivalDate           DateTime?
  delayHours                  Float     @default(0.0)
  transitStatus               String    @default("IN_TRANSIT") // "PICKUP_SCHEDULED", "IN_TRANSIT", "DELAYED_WEATHER_ROUTE", "ARRIVED_AT_GATE", "UNLOADED"
  dockUnloadBay               String?   // e.g. "BAY-INB-DOCK-01"
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([trackingCode])
  @@index([vendorSupplierName])
  @@index([transitStatus])
  @@map("logistics_inbound_transports")
}

// 
// 2. Outbound Logistics & Finished Goods Dispatch
// Functions:
// - Vehicle allocation (heavy lorries, trailers, mini-trucks)
// - Multi-location delivery route planning & scheduling
// - Carrier freight rate negotiation and booking
// - Outbound transit scheduling and dispatch monitoring
//
model LogisticsOutboundDispatch {
  id                          String    @id @default(uuid())
  dispatchPlanCode            String    @unique // e.g. "OUT-DISP-2026-201"
  salesOrderRef               String?   // e.g. "SO-2026-110"
  clientConsigneeName         String
  destinationRoute            String    // e.g. "Pune - Chakan - Talegaon Corridor"
  vehicleTypeAllocated        String    // "HEAVY_LORRY_32_FT", "CONTAINER_TRAILER", "MINI_TRUCK_EICHER", "LIGHT_COMMERCIAL_VEHICLE"
  allocatedVehicleNumber      String    // e.g. "MH-14-AZ-4410"
  transporterAgency           String    // e.g. "Safexpress Industrial Cargo"
  freightRateNegotiated       Float     // in INR
  freightRateType             String    @default("PER_TRIP_FLAT") // "PER_TRIP_FLAT", "PER_TON_KM", "PER_KG"
  multiDropLocationsJson      String?   // JSON array of delivery drops
  totalWeightKg               Float
  scheduledDeparture          DateTime
  dispatchStatus              String    @default("SCHEDULED") // "SCHEDULED", "STAGED_AT_BAY", "DISPATCHED_ON_ROUTE", "DELIVERED_POD_RECEIVED"
  podReceived                 Boolean   @default(false)
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([dispatchPlanCode])
  @@index([clientConsigneeName])
  @@index([dispatchStatus])
  @@map("logistics_outbound_dispatches")
}

// 
// 3. Warehousing, Storage & Material Handling
// Functions:
// - Vertical racking storage and bin location mapping
// - Material Handling Equipment (MHE) logs (Forklifts, overhead EOT cranes)
// - Heavy industrial component movement and stacking safety
// - Warehouse ambient temperature and relative humidity telemetry
//
model LogisticsWarehouseHandling {
  id                          String    @id @default(uuid())
  handlingRecordCode          String    @unique // e.g. "MHE-HND-2026-301"
  warehouseZone               String    // e.g. "ZONE-A-HEAVY-METALS", "ZONE-B-FINISHED-GOODS"
  binRackingLocation          String    // e.g. "RACK-V4-BIN-12"
  storedItemDescription       String
  handlingEquipmentUsed       String    // "FORKLIFT_3_TON", "OVERHEAD_EOT_CRANE_15T", "REACH_TRUCK", "PALLET_JACK_ELECTRIC"
  equipmentOperatorName       String
  loadWeightKg                Float
  ambientTemperatureC         Float?    // e.g. 24.5 C
  relativeHumidityPct         Float?    // e.g. 48.0 %
  storageConditionStatus      String    @default("OPTIMAL") // "OPTIMAL", "TEMPERATURE_ALERT", "HUMIDITY_WARNING", "RACK_OVERLOAD_RISK"
  stackingSafetyClearance     Boolean   @default(true)
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([handlingRecordCode])
  @@index([warehouseZone])
  @@index([storageConditionStatus])
  @@map("logistics_warehouse_handlings")
}

// 
// 4. Statutory Documentation & Compliance (E-Way Bills)
// Functions:
// - e-Way bills generation and validity expiration monitoring
// - Delivery Challans and Tax Invoice transit verification
// - Plant weighbridge outward slips integration
// - Interstate permits and digital QR-code verification
//
model LogisticsStatutoryDoc {
  id                          String    @id @default(uuid())
  documentCode                String    @unique // e.g. "STAT-DOC-2026-401"
  consignorOrConsignee        String    // e.g. "Mahindra Automotive Foundry Division"
  documentType                String    // "E_WAY_BILL", "DELIVERY_CHALLAN", "WEIGHBRIDGE_OUTWARD_SLIP", "TRANSPORTER_CONSIGNMENT_NOTE", "TAX_INVOICE_TRANSIT_PASS"
  documentReferenceNumber     String    // e.g. "EWB-291049182740" or "DC-2026-8812"
  invoiceReferenceNumber      String?
  weighbridgeSlipNumber       String?
  vehicleNumber               String
  validFrom                   DateTime
  validTill                   DateTime
  complianceVerificationStatus String   @default("VALID_VERIFIED") // "VALID_VERIFIED", "EXPIRED_ALERT", "UNDER_SCRUTINY", "GATE_CLEARED"
  interstatePermit            Boolean   @default(false)
  digitalQrcodeVerified       Boolean   @default(true)
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([documentCode])
  @@index([documentType])
  @@index([complianceVerificationStatus])
  @@map("logistics_statutory_docs")
}

// 
// 5. Fleet Management & Vehicle Maintenance
// Functions:
// - Commercial vehicle fitness certificate tracking & renewals
// - Comprehensive insurance and PUC emission certificate alerts
// - Routine servicing schedules and odometer maintenance thresholds
// - Real-time GPS tracking and transit telematics
//
model LogisticsFleetMaintenance {
  id                          String    @id @default(uuid())
  fleetVehicleCode            String    @unique // e.g. "FLEET-TRK-01"
  registrationNumber          String    // e.g. "MH-12-RN-9921"
  vehicleModel                String    // e.g. "Tata Signa 3523.TK (Multi-Axle 35T)"
  ownershipType               String    @default("COMPANY_OWNED") // "COMPANY_OWNED", "DEDICATED_CONTRACT_LEASE", "SPOT_MARKET_CARRIER"
  fitnessCertificateExpiry    DateTime
  insurancePolicyExpiry       DateTime
  pucEmissionExpiry           DateTime
  currentOdometerKm           Float
  fuelConsumptionLiters       Float     @default(0.0)
  fuelMileageKmpl             Float?
  lastServicingDate           DateTime?
  nextServicingDueKm          Float?
  gpsDeviceImei               String?
  liveLocationCoordinates     String?   // e.g. "18.5204 N, 73.8567 E (Pune Bypass NH48)"
  vehicleStatus               String    @default("ACTIVE_ON_ROAD") // "ACTIVE_ON_ROAD", "IN_WORKSHOP_SERVICING", "FITNESS_RENEWAL_DUE", "STANDBY_YARD"
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([fleetVehicleCode])
  @@index([registrationNumber])
  @@index([vehicleStatus])
  @@map("logistics_fleet_maintenances")
}

// 
// 6. Freight Cost Optimization & Logistics Auditing
// Functions:
// - Monthly transporter freight bill verification and invoice audit
// - Empty return trip elimination through backhauling and load consolidation
// - Cost per ton-km optimization analysis
// - Annual freight contract negotiations and rate revisions
//
model LogisticsFreightAudit {
  id                          String    @id @default(uuid())
  auditInvoiceCode            String    @unique // e.g. "FRT-AUD-2026-601"
  transporterAgencyName       String    // e.g. "VRL Logistics Heavy Freight Fleet"
  billingPeriod               String    // e.g. "2026-11"
  contractAgreementCode       String?   // e.g. "ARC-FRT-2026-02"
  totalBilledAmount           Float
  verifiedApprovedAmount      Float
  discrepancyDeductionAmount  Float     @default(0.0)
  totalTripsAudited           Int
  emptyReturnTripCount        Int       @default(0)
  backhaulingConsolidationCount Int     @default(0)
  costPerTonKmCalculated      Float?    // e.g. 2.45 INR / ton-km
  auditApprovalStatus         String    @default("AUDIT_PASSED_APPROVED") // "AUDIT_PASSED_APPROVED", "VARIANCE_DISPUTED", "SETTLED_RELEASED", "UNDER_REVIEW"
  settlementReferenceUTR      String?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([auditInvoiceCode])
  @@index([transporterAgencyName])
  @@index([auditApprovalStatus])
  @@map("logistics_freight_audits")
}

// =========================================================================
// GATE SECURITY DEPARTMENT MULTI-TENANT ENTITIES (Strict Company Isolation)
// =========================================================================

// 
// 1. Inward & Outward Vehicle Gate Entry
// Functions:
// - Vehicle number, driver details, license, and transport fleet
// - E-way bill, tax invoice, and delivery challan transit documents
// - Inward & outward timestamps with fast-pass gate clearance
// - Weighbridge gross, tare, and net tonnage recording integration
//
model GateVehicleEntry {
  id                          String    @id @default(uuid())
  gatePassNumber              String    @unique // e.g. "GATE-VEH-2026-101"
  vehicleNumber               String    // e.g. "MH-12-RN-9921"
  vehicleType                 String    // "HEAVY_LORRY", "CONTAINER_TRAILER", "TANKER", "LCV_MINI_TRUCK", "VISITOR_CAR", "TWO_WHEELER"
  driverName                  String
  driverPhone                 String?
  driverLicenseNumber         String?
  transporterAgency           String?
  entryPurpose                String    // "RAW_MATERIAL_INWARD", "FINISHED_GOODS_OUTWARD", "SPARES_CONSUMABLES", "SCRAP_OUTWARD", "VISITOR_TRANSPORT"
  ewayBillNumber              String?
  taxInvoiceRef               String?
  deliveryChallanRef          String?
  inwardTimestamp             DateTime  @default(now())
  outwardTimestamp            DateTime?
  grossWeightKg               Float?
  tareWeightKg                Float?
  netWeightKg                 Float?
  gateEntryStatus             String    @default("ENTRY_LOGGED") // "ENTRY_LOGGED", "WEIGHBRIDGE_IN_PROGRESS", "UNLOADING_LOADING_AT_BAY", "WEIGHBRIDGE_OUT_COMPLETED", "EXIT_CLEARED"
  securityOfficerName         String
  sealNumberVerified          Boolean   @default(true)
  securityCheckNotes          String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([gatePassNumber])
  @@index([vehicleNumber])
  @@index([gateEntryStatus])
  @@map("gate_vehicle_entries")
}

// 
// 2. Visitor Management & Contractor Access Control
// Functions:
// - Temporary visitor pass issuance & RFID badge allocation
// - Government ID proof verification (Aadhaar, DL, PAN, Passport)
// - Host department manager approval & visit purpose tracking
// - Mandatory plant safety PPE compliance validation (helmet, vest, shoes)
//
model GateVisitorAccess {
  id                          String    @id @default(uuid())
  visitorPassNumber           String    @unique // e.g. "VIS-PASS-2026-201"
  visitorName                 String
  visitorPhone                String
  visitorOrganization         String    // Company or contractor firm represented
  idProofType                 String    // "AADHAAR", "DRIVING_LICENSE", "PAN_CARD", "PASSPORT", "VOTER_ID"
  idProofNumber               String
  hostPersonToMeet            String    // Employee or department lead
  hostDepartment              String    // "HR", "PRODUCTION", "PROCUREMENT", "QUALITY", "EXECUTIVE", "MAINTENANCE"
  visitPurpose                String    // "VENDOR_MEETING", "CANDIDATE_INTERVIEW", "AUDIT_INSPECTION", "MACHINE_SERVICING", "CLIENT_VISIT", "CONTRACTOR_WORK"
  departmentApprovalStatus    String    @default("PENDING") // "PENDING", "APPROVED_BY_MANAGER", "REJECTED", "VISIT_COMPLETED"
  approvingManagerName        String?
  rfidCardBadgeNumber         String?   // e.g. "RFID-VIS-042"
  safetyPpeHelmetIssued       Boolean   @default(true)
  safetyPpeVestIssued         Boolean   @default(true)
  safetyPpeShoesVerified      Boolean   @default(true)
  safetyBriefingAcknowledged  Boolean   @default(true)
  checkInTime                 DateTime  @default(now())
  checkOutTime                DateTime?
  accessStatus                String    @default("ACTIVE_IN_PLANT") // "ACTIVE_IN_PLANT", "CHECKED_OUT", "OVERSTAY_ALERT", "ACCESS_DENIED"
  securityNotes               String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([visitorPassNumber])
  @@index([visitorPhone])
  @@index([accessStatus])
  @@map("gate_visitor_accesses")
}

// 
// 3. Material Inward/Outward Physical Inspection & Frisking
// Functions:
// - Truck container physical seal verification & tarpaulin checks
// - Gate pass vs actual physical load verification
// - Outgoing contract labor & driver frisking logs
// - Smuggling, pilferage, and cargo discrepancy flagging
//
model GateMaterialInspection {
  id                          String    @id @default(uuid())
  inspectionRecordCode        String    @unique // e.g. "MAT-INSP-2026-301"
  vehicleNumber               String
  gatePassRef                 String?
  challanInvoiceRef           String?
  materialType                String    // "RAW_MATERIAL", "FINISHED_GOODS", "SPARE_PARTS", "SCRAP_METAL", "SUBCONTRACT_JOBWORK"
  containerInspectionStatus   String    // "SEAL_INTACT_VERIFIED", "SEAL_BROKEN_ALERT", "TARPAULIN_COVERED_OK", "OPEN_BODY_CHECKED"
  containerSealNumber         String?
  physicalVsChallanMatch      String    // "MATCHED_VERIFIED", "QUANTITY_SHORTAGE", "EXCESS_UNAUTHORIZED_CARGO", "WRONG_ITEM_DETECTED"
  contractLaborFriskingDone   Boolean   @default(true)
  metalDetectorCleared        Boolean   @default(true)
  unauthorizedMaterialFound   Boolean   @default(false)
  smugglingAlertFlag          Boolean   @default(false)
  discrepancyRemarks          String?
  inspectingOfficerName       String
  inspectionStatus            String    @default("PASSED_CLEARED") // "PASSED_CLEARED", "DETAINED_FOR_AUDIT", "REJECTED_TURNED_BACK", "ESCALATED_TO_SECURITY_HEAD"

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([inspectionRecordCode])
  @@index([vehicleNumber])
  @@index([inspectionStatus])
  @@map("gate_material_inspections")
}

// 
// 4. Visitor & Employee Parking & Traffic Management
// Functions:
// - Heavy industrial truck bay guidance & loading dock queuing
// - Staff, contractor & visitor two-wheeler / four-wheeler parking allocation
// - Emergency fire exit & hydrants clearance verification
// - Unauthorized parking & traffic obstruction alert monitoring
//
model GateTrafficParking {
  id                          String    @id @default(uuid())
  trafficSlotCode             String    @unique // e.g. "TRF-PRK-2026-401"
  vehicleCategory             String    // "HEAVY_TRUCK_LORRY", "CONTAINER_TRAILER", "STAFF_FOUR_WHEELER", "TWO_WHEELER", "VISITOR_VEHICLE", "COMPANY_BUS"
  vehicleRegistrationNumber   String
  allocatedSlotOrBay          String    // e.g. "BAY-03-UNLOAD", "TRUCK-YARD-T12", "STAFF-P1-24", "VISITOR-V05"
  driverOrOwnerName           String
  driverContactPhone          String?
  entryTime                   DateTime  @default(now())
  exitTime                    DateTime?
  fireExitClearanceVerified   Boolean   @default(true) // Guaranteed not blocking fire hydrants / emergency exit routes
  parkingViolationStatus      String    @default("NO_VIOLATION") // "NO_VIOLATION", "OBSTRUCTING_FIRE_LANE", "UNAUTHORIZED_BAY_PARKING", "OVERNIGHT_UNAUTHORIZED", "RESOLVED"
  trafficGuardName            String
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([trafficSlotCode])
  @@index([vehicleRegistrationNumber])
  @@index([parkingViolationStatus])
  @@map("gate_traffic_parkings")
}

// 
// 5. Safety, Fire & Emergency Gate Control
// Functions:
// - Emergency / fire alarm automated gate operations (immediate barrier release)
// - Emergency rapid contacts dispatch (Police 100, Fire 101, Ambulance 108, Plant Hospital)
// - Gate CCTV surveillance telemetry & perimeter tripwire monitoring
// - Evacuation head-count gateway clearance logging
//
model GateEmergencyControl {
  id                          String    @id @default(uuid())
  incidentLogCode             String    @unique // e.g. "EMG-GATE-2026-501"
  incidentType                String    // "FIRE_ALARM_EVACUATION", "CHEMICAL_LEAK_HAZMAT", "MEDICAL_AMBULANCE_CALL", "POLICE_SECURITY_BREACH", "SEVERE_WEATHER_ALERT", "SAFETY_MOCK_DRILL"
  gateOperationsMode          String    @default("NORMAL_SECURITY_CHECK") // "NORMAL_SECURITY_CHECK", "EMERGENCY_ALL_GATES_OPEN", "RESTRICTED_LOCKDOWN", "EVACUATION_CLEARANCE"
  emergencyAgencyNotified     String    // "FIRE_BRIGADE_101", "POLICE_CONTROL_100", "AMBULANCE_DISPATCH_108", "INTERNAL_EHS_TEAM", "ALL_SERVICES_DISPATCHED"
  emergencyContactPhone       String?
  cctvSurveillanceStatus      String    @default("ALL_CAMERAS_OPERATIONAL") // "ALL_CAMERAS_OPERATIONAL", "BLINDSPOT_ALERT", "PERIMETER_ALARM_TRIGGERED"
  gateStationNumber           String    // e.g. "GATE-01-MAIN", "GATE-02-LOGISTICS", "GATE-03-EMERGENCY-EXIT"
  incidentSeverity            String    @default("MEDIUM_CONTROLLED") // "LOW_MOCK_DRILL", "MEDIUM_CONTROLLED", "HIGH_ACTIVE_EMERGENCY", "CRITICAL_EVACUATE"
  incidentStartTime           DateTime  @default(now())
  incidentResolvedTime        DateTime?
  resolutionSummary           String?
  commandingOfficerName       String
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([incidentLogCode])
  @@index([incidentType])
  @@index([gateOperationsMode])
  @@map("gate_emergency_controls")
}

// 
// 6. Night Shift Patrol & Asset Protection
// Functions:
// - Night shift perimeter guard patrolling & RFID checkpoint scans
// - Finished goods storage yard & restricted zone lock-down verification
// - Perimeter boundary wall, fencing & floodlight status audits
// - Suspicious activity alerts and instant escalation to Security Head
//
model GateNightPatrol {
  id                          String    @id @default(uuid())
  patrolLogCode               String    @unique // e.g. "PAT-NGT-2026-601"
  patrolShift                 String    // "NIGHT_SHIFT_FIRST_HALF", "NIGHT_SHIFT_SECOND_HALF", "GRAVEYARD_PATROL_02AM"
  leadPatrolGuardName         String
  accompanyingGuards          String?   // e.g. "Guard Anil Yadav, Guard Ramesh Shinde"
  patrolCheckpointZone        String    // "PERIMETER_NORTH_FENCE", "FINISHED_GOODS_YARD", "RAW_SCRAP_YARD", "HAZMAT_STORAGE", "SUBSTATION_TRANSFORMER", "ADMIN_OFFICE"
  checkpointScanTime          DateTime  @default(now())
  physicalLockSecure          Boolean   @default(true)
  lockConditionDetails        String?   // "Padlocks and digital seals checked and intact"
  perimeterLightingStatus     String    @default("ADEQUATE_FLOODLIGHTS") // "ADEQUATE_FLOODLIGHTS", "PARTIAL_DARKNESS", "FLOODLIGHT_FUSED_ALERT"
  suspiciousActivityDetected  Boolean   @default(false)
  suspiciousDetails           String?
  escalatedToSecurityManager  Boolean   @default(false)
  securityManagerActionNotes  String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([patrolLogCode])
  @@index([patrolCheckpointZone])
  @@index([suspiciousActivityDetected])
  @@map("gate_night_patrols")
}
