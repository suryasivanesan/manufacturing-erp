// 
// 1. HIDE_WETBLUE_MANAGER
// Core Functions:
// - Raw hide grading by weight and size (Cow, Buffalo, Goat, Sheep)
// - Chemical recipe dosing in tanning drums (Chrome basicity, pickling, sodium formate)
// - pH level and drum rotation cycle monitoring (Boil shrinkage test >= 100°C)
// - Wet-blue lot inventory logging and yield pieces tracking
//
model HideWetBlueBatch {
  id                      String    @id @default(uuid())
  batchNumber             String    @unique // e.g. "WBT-2026-001"
  drumNumber              String    // e.g. "DRUM-TAN-04"
  rawHideType             String    // "COW_HIDE", "BUFFALO_HIDE", "GOAT_SKIN", "SHEEP_SKIN"
  rawHideGrade            String    // "GRADE_A_HEAVY", "GRADE_B_MEDIUM", "GRADE_C_LIGHT"
  rawHideWeightKg         Float     // Total green salted or fresh hide weight e.g. 2450.0
  hidePiecesCount         Int       // Total count of raw hides loaded e.g. 120
  averageWeightPerHideKg  Float     // Calculated avg weight per hide e.g. 20.42
  chemicalRecipeCode      String    // Recipe identifier e.g. "REC-CHROME-TAN-901"
  chromeBasicityPct       Float     // Basic chromium sulfate basicity e.g. 33.0%
  tanningAgentKg          Float     // Total BCS / tanning chemicals dosed e.g. 185.0
  soakingLimingHours      Float     // Beamhouse soaking & liming cycle hours e.g. 16.0
  drumRotationRpm         Float     // Tanning drum operational speed e.g. 14.5 RPM
  cycleDurationHours      Float     // Total tanning cycle duration e.g. 8.5
  initialPh               Float     // Deliming / bating pH e.g. 8.2
  finalTanPh              Float     // Basification end pH e.g. 3.8
  shrinkageTempCelsius    Float     // Hydrothermal boil test temperature e.g. 102.5°C
  wetBlueLotNumber        String    // Wet-blue output lot e.g. "WBL-2026-8812"
  wetBlueYieldPieces      Int       // Sound wet-blue hides harvested e.g. 120
  status                  String    @default("COMPLETED") // "SOAKING_LIMING", "PICKLING_TANNING", "COMPLETED", "DEFECT_QUARANTINE"
  operatorNotes           String?

  companyId               String
  company                 Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([companyId])
  @@index([batchNumber])
  @@index([wetBlueLotNumber])
  @@index([rawHideType])
  @@index([status])
  @@map("hide_wet_blue_batches")
}

// 
// 2. RETANNING_DYEING_CRUST_MANAGER
// Core Functions:
// - Leather dye formulation management & fatliquor dosing (Color matching)
