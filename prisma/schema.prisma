// 
// 5. 4-Point Fabric Inspection, GSM Testing & Quality Clearance Certificate
// Governed by FABRIC_QUALITY_INSPECTION_MANAGER:
// - 4-point fabric inspection system defect grading (ASTM D5430)
// - GSM, tensile tear strength & shrinkage test recording
// - Color fastness to washing & rub testing verification
// - Textile quality clearance certificate (CoA) issuance & dispatch gate control
//
model FabricQualityInspection {
  id                          String    @id @default(uuid())
  inspectionReportCode        String    @unique // e.g. "TEX-QA-2026-401"
  fabricRollNumber            String    // e.g. "ROLL-DYED-2026-992"
  fabricConstruction          String    // e.g. "100% Combed Cotton Single Jersey 180 GSM"
  inspectedLengthMeters       Float     // Roll inspected length e.g. 120.0 m
  widthInches                 Float     // Fabric width e.g. 60.0 inches
  measuredGsm                 Float     // Measured grams per square meter e.g. 182.0
  targetGsm                   Float     // Nominal target GSM e.g. 180.0
  warpShrinkagePct            Float     // Dimensional stability warp shrinkage e.g. 2.1% (<= 3.0%)
  weftShrinkagePct            Float     // Dimensional stability weft shrinkage e.g. 1.8% (<= 3.0%)
  fourPointDefectScore        Float     // ASTM D5430 4-Point System points per 100 sq yards e.g. 16.5
  maxAllowableDefectScore     Float     @default(28.0) // 4-Point threshold e.g. 28.0 points / 100 sq yd
  colorFastnessRating         Float     @default(4.5) // Gray scale rating (1-5) for washing / rub fastness e.g. 4.5
  inspectionResult            String    @default("PASSED") // PASSED, SECONDS_GRADE, REJECTED
  dispatchBlocked             Boolean   @default(false) // Gate lockout if rejected
  qualityCertificateNumber    String?   @unique // e.g. "QC-CERT-TEX-2026-001"
  certifiedAt                 DateTime?
  certifiedByRole             String    @default("FABRIC_QUALITY_INSPECTION_MANAGER")
  remarks                     String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([inspectionReportCode])
  @@index([fabricRollNumber])
  @@index([inspectionResult])
  @@map("fabric_quality_inspections")
}

// ============================================================================
// CONSUMER GOODS / JEWELLERY SPECIALIZED OPERATIONAL ENTITIES
