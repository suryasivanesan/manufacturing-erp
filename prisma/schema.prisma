  updatedAt                 DateTime  @updatedAt

  @@index([companyId])
  @@index([batchCode])
  @@index([wetBlueLotNumber])
  @@index([leatherArticle])
  @@index([status])
  @@map("retanning_dyeing_crust_logs")
}

// 
// 3. SPLITTING_SHAVING_CALIBRATION_MANAGER
// Core Functions:
// - Splitting and shaving machine blade calibration & continuous sharpening
// - Thickness gauge measurement recording across sampling points (5-point matrix)
// - Leather shaving waste tracking & drop-split utilization
// - Lot segregation by thickness range (Upper, Lining, Sole)
//
model SplittingShavingLog {
  id                          String    @id @default(uuid())
  logNumber                   String    @unique // e.g. "SPL-SHV-2026-201"
  machineId                   String    // e.g. "Bandknife Splitting Machine #02 (Mosconi)"
  bladeCalibrationStatus      String    @default("CALIBRATED") // "CALIBRATED", "BLADE_WEAR_ALERT", "REALIGNMENT_DUE"
  bladeSharpnessIndex         Float     // e.g. 98.5%
  targetThicknessMm           Float     // Nominal spec thickness e.g. 1.30 mm
  toleranceMm                 Float     // Permissible variation e.g. 0.05 mm
  point1ThicknessMm           Float     // Neck sampling point e.g. 1.31 mm
  point2ThicknessMm           Float     // Left belly sampling point e.g. 1.29 mm
  point3ThicknessMm           Float     // Center butt sampling point e.g. 1.30 mm
  point4ThicknessMm           Float     // Right belly sampling point e.g. 1.32 mm
  point5ThicknessMm           Float     // Shank/tail sampling point e.g. 1.30 mm
  averageThicknessMm          Float     // Calculated 5-point average e.g. 1.304 mm
  thicknessUniformityStatus   String    @default("UNIFORM") // "UNIFORM", "OUT_OF_TOLERANCE", "RE_SHAVING_DUE"
  shavingWasteWeightKg        Float     // Wet shaving dust/scrap e.g. 85.0 kg
  hidesProcessed              Int       // Quantity of hides split/shaved e.g. 120
  thicknessRangeCategory      String    // e.g. "1.2 - 1.4 mm Upper Standard"
  splitDropAction             String    // "SUEDE_SPLIT_STAGED", "DROP_SPLIT_SCRAP"
  status                      String    @default("INSPECTION_PASSED") // "IN_PROGRESS", "INSPECTION_PASSED", "CALIBRATION_HOLD"
  operatorNotes               String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([logNumber])
  @@index([machineId])
  @@index([thicknessUniformityStatus])
  @@index([status])
  @@map("splitting_shaving_logs")
}

// 
// 4. FINISHING_BUFFING_EMBOSSING_MANAGER
// Core Functions:
// - Finishing chemical formulation management (Polyurethane/acrylic base, crosslinkers)
// - Spray booth parameter tracking (Fluid viscosity, atomization pressure, drying tunnel °C)
// - Plate embossing schedules - Croco, Nappa, Pebble, Saffiano grain patterns
// - Gloss/luster consistency monitoring (Gloss Units @ 60°) & Veslic rub fastness
//
model FinishingEmbossingLog {
  id                          String    @id @default(uuid())
  finishBatchCode             String    @unique // e.g. "FIN-EMB-2026-301"
  articleName                 String    // e.g. "Classic Nappa Calfskin Tan"
  finishFormulationCode       String    // e.g. "FORM-POLYURETHANE-TOP-77"
  finishingType               String    // "ANILINE", "SEMI_ANILINE", "PIGMENTED", "PULL_UP", "PATENT"
  sprayBoothLineId            String    // e.g. "Rotary Spray Machine Line 01"
  sprayViscositySecs          Float     // Ford Cup #4 flow viscosity e.g. 18.5
  sprayPressureBar            Float     // Atomization nozzle pressure e.g. 3.2
  tunnelDryingTempCelsius     Float     // In-line drying infrared tunnel e.g. 85.0°C
  embossingPattern            String    // "NAPPA", "CROCO", "PEBBLE_GRAIN", "SAFFIANO", "SMOOTH"
  embossingPlateTempCelsius   Float     // Hydraulic heated plate temp e.g. 95.0°C
  embossingPressureBar        Float     // Hydraulic tonnage pressure e.g. 180.0
