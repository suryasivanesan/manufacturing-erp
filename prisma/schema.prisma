// Prisma schema file for Manufacturing ERP
// Configured for PostgreSQL (Cloud Ready: Render, Railway, Neon, Supabase, Docker)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String   @id @default(uuid())
  companyName      String   // Registered trade or enterprise name
  name             String?  // Alias for backward compatibility
  code             String?  @unique // e.g. "MFG-STEE-4921"
  gstNumber        String   @unique // Alphanumeric GSTIN identification
  email            String   @unique // Official corporate email
  password         String   // Hashed with bcrypt

  // Refined Industry Classification & Unit Mapping (Strict 5 Categories & 15 Sub-Categories)
  // 1. Heavy and Raw Materials:
  //    - Steel and Heavy Metals (defaultUnit: MT)
  //    - Glass and Ceramic (defaultUnit: m2)
  // 2. Chemical Industries:
  //    - Chemicals (defaultUnit: ltr)
  //    - Paint (defaultUnit: ltr)
  //    - Rubber & Tyre (defaultUnit: kg)
  //    - Plastic and Polymer (defaultUnit: kg)
  //    - Pipes (defaultUnit: m)
  // 3. Engineering, Machinery and Electronics:
  //    - Automobiles (defaultUnit: Pcs)
  //    - Electronical (defaultUnit: Pcs)
  //    - Cable Wires (defaultUnit: m)
  // 4. Consumer Goods:
  //    - Textiles (defaultUnit: m)
  //    - Jewellery (defaultUnit: gm)
  //    - Leather (defaultUnit: m2)
  //    - Furniture (defaultUnit: Pcs)
  // 5. Food:
  //    - Dairy Product (defaultUnit: ltr)
  industryCategory String   // Heavy and Raw Materials | Chemical Industries | Engineering, Machinery and Electronics | Consumer Goods | Food
  subCategory      String   // Specific sector strictly mapped from the 15 refined sub-categories
  defaultUnit      String   // Associated unit: MT, kg, m, m2, ltr, gm, Pcs

  // Location & Contact Details
  phone            String?
  address          String?
  city             String?
  state            String?
  country          String?  @default("India")

  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]

  // Steel & Heavy Metals Specialized Operational Records
  weighbridgeSlips       WeighbridgeSlip[]
  metallurgyHeatTests    MetallurgyHeatTest[]
  subcontractingChallans SubcontractingChallan[]
  ehsIncidentRecords     EhsIncidentRecord[]

  // Glass & Ceramic Specialized Operational Records
  glassBatchFormulas         GlassBatchFormula[]
  kilnFurnaceLogs            KilnFurnaceLog[]
  mouldToolingRecords        MouldToolingRecord[]
  thermalQualityInspections  ThermalQualityInspection[]
  culletRecoveryRecords      CulletRecoveryRecord[]

  // Process & Chemical Industries / Chemical Specialized Operational Records
  chemicalFormulaMasters     ChemicalFormulaMaster[]
  chemicalHazmatRecords      ChemicalHazmatRecord[]
  analyticalLabTests         AnalyticalLabTest[]
  reactorBatchCycles         ReactorBatchCycle[]
  dangerousGoodsLogistics    DangerousGoodsLogistics[]

  // Process & Chemical Industries / Paint Specialized Operational Records
  paintShadeMasters          PaintShadeMaster[]
  paintDispersionBatches      PaintDispersionBatch[]
  paintRheologyTests          PaintRheologyTest[]
  paintBaseStockTintings      PaintBaseStockTinting[]
  paintPackagingCompliances   PaintPackagingCompliance[]

  // Process & Chemical Industries / Rubber & Tyre Specialized Operational Records
  rubberCompoundingBatches   RubberCompoundingBatch[]
  extrusionCalenderingLogs   ExtrusionCalenderingLog[]
  tyreBuildingRecords        TyreBuildingRecord[]
  curingVulcanizationLogs    CuringVulcanizationLog[]
  tyreUniformityTests        TyreUniformityTest[]

  // Chemical Industries / Pipes Specialized Operational Records
  pipeExtrusionLogs          PipeExtrusionLog[]
  pipeUltrasonicInspections  PipeUltrasonicInspection[]
  hydrostaticBurstTests      HydrostaticBurstTest[]
  bellingSocketingLogs       BellingSocketingLog[]
  pvcDryBlendBatches         PvcDryBlendBatch[]

  // Engineering, Machinery and Electronics / Automobiles Specialized Operational Records
  automobileKanbanSignals    AutomobileKanbanSignal[]
  pressShopBiwLogs           PressShopBiwLog[]
  vehicleAssemblyRecords     VehicleAssemblyRecord[]
  paintShopCorrosionLogs     PaintShopCorrosionLog[]
  eolVinTestingRecords       EolVinTestingRecord[]

  // Engineering, Machinery and Electronics / Electronical Specialized Operational Records
  smtPcbAssemblyLogs         SmtPcbAssemblyLog[]
  electricalTestingRecords   ElectricalTestingRecord[]
  firmwareFlashingLogs       FirmwareFlashingLog[]
  componentEbomRecords       ComponentEbomRecord[]
  esdCleanroomAuditLogs      EsdCleanroomAuditLog[]

  // Engineering, Machinery and Electronics / Electric Equipment Specialized Operational Records
  coilWindingLogs            CoilWindingFabricationLog[]
  coreLaminationLogs         CoreAssemblyLaminationLog[]
  vpiInsulationLogs          VpiInsulationProcessLog[]
  hvRoutineTestRecords       HvRoutineTestingRecord[]
  busbarEnclosureLogs        BusbarEnclosureFabricationLog[]

  // Engineering, Machinery and Electronics / Cable Wire Specialized Operational Records
  wireDrawingAnnealingLogs   WireDrawingAnnealingLog[]
  bunchingStrandingLogs      BunchingStrandingLog[]
  insulationSheathingLogs    InsulationSheathingLog[]
  armouringBeddingLogs       ArmouringBeddingLog[]
  hvSparkTestingQaRecords    HvSparkTestingQaRecord[]

  // Consumer Goods / Textiles Specialized Operational Records
  spinningYarnLogs           SpinningYarnLog[]
  weavingKnittingLogs        WeavingKnittingLog[]
  dyeingProcessLogs          DyeingProcessLog[]
  garmentingFinishingLogs    GarmentingFinishingLog[]
  fabricQualityInspections   FabricQualityInspection[]

  // Consumer Goods / Jewellery Specialized Operational Records
  bullionVaultLedgers        BullionVaultLedger[]
  cadCamPrototypingLogs      CadCamPrototypingLog[]
  castingMeltingCycles       CastingMeltingCycle[]
  karigarJobWorks            KarigarJobWork[]
  jewelleryHallmarkingQcs    JewelleryHallmarkingQc[]

  // Consumer Goods / Leather Specialized Operational Records
  hideWetBlueBatches         HideWetBlueBatch[]
  retanningDyeingCrustLogs   RetanningDyeingCrustLog[]
  splittingShavingLogs       SplittingShavingLog[]
  finishingEmbossingLogs     FinishingEmbossingLog[]
  leatherQcAreaRecords       LeatherQcAreaRecord[]

  // Consumer Goods / Furniture Specialized Operational Records
  timberKilnBatches          TimberKilnBatch[]
  cncNestingPanelLogs        CncNestingPanelLog[]
  upholsteryFoamCuttingLogs  UpholsteryFoamCuttingLog[]
  sandingFinishingLogs       SandingFinishingLog[]
  kdPackagingKittingRecords  KdPackagingKittingRecord[]

  // Food Manufacturing / Dairy Product Specialized Operational Records
  milkCollectionReceptionRecords MilkCollectionReceptionRecord[]
  pasteurizationProcessingLogs   PasteurizationProcessingLog[]
  fermentationCultureBatches     FermentationCultureBatch[]
  dairyQaMbrtAntibioticRecords   DairyQaMbrtAntibioticRecord[]
  coldChainLogisticsRecords      ColdChainLogisticsRecord[]

  // Core ERP Multi-Tenant Management Entities (Super Admin Governance)
  rawMaterials               RawMaterial[]
  products                   Product[]
  productRawMaterials        ProductRawMaterial[]
  rawMaterialRateRequests    RawMaterialRateRequest[]
  notifications              Notification[]
  employeePayrolls           EmployeePayroll[]
  auditLogs                  AuditLog[]
  approvalRequests           ApprovalRequest[]

  // Quality Department Multi-Tenant Entities
  qualityTasks               QualityTask[]
  qualityChecks              QualityCheck[]
  qualityReports             QualityReport[]
  departmentLabors           DepartmentLabor[]

  // Inventory Department Multi-Tenant Entities
  inventoryTasks             InventoryTask[]
  warehouseStorages          WarehouseStorage[]
  productionTransfers        ProductionTransfer[]
  inventoryReports           InventoryReport[]
  inventoryDepartmentLabors  InventoryDepartmentLabor[]

  // Finance Department Multi-Tenant Entities
  financeTasks               FinanceTask[]
  financialMetrics           FinancialMetric[]
  payrollRequests            PayrollRequest[]
  cashBankLedgers            CashBankLedger[]
  taxRecords                 TaxRecord[]

  // Human Resources (HR) Department Multi-Tenant Entities (Strict Company Isolation)
  hrRecruitmentRecords       HrRecruitmentRecord[]
  hrAttendancePayrolls       HrAttendancePayroll[]
  hrStatutoryCompliances     HrStatutoryCompliance[]
  hrSafetyWelfares           HrSafetyWelfare[]
  hrTrainingCertifications   HrTrainingCertification[]
  hrEmployeeRelations        HrEmployeeRelation[]

  // Procurement Department Multi-Tenant Entities (Strict Company Isolation)
  procurementSourcings       ProcurementSourcing[]
  purchaseOrderFlows         PurchaseOrderFlow[]
  materialInwardLogistics    MaterialInwardLogistics[]
  bufferStockPlannings       BufferStockPlanning[]
  vendorReconciliations      VendorReconciliation[]
  scrapDisposalManagements   ScrapDisposalManagement[]

  // Sales Department Multi-Tenant Entities (Strict Company Isolation)
  salesLeadAcquisitions      SalesLeadAcquisition[]
  salesQuotationNegotiations SalesQuotationNegotiation[]
  salesOrderExecutions       SalesOrderExecution[]
  salesDispatchLogistics     SalesDispatchLogistics[]
  salesCreditBillings        SalesCreditBilling[]
  salesCustomerFeedbacks     SalesCustomerFeedback[]

  // Logistics Department Multi-Tenant Entities (Strict Company Isolation)
  logisticsInboundTransports   LogisticsInboundTransport[]
  logisticsOutboundDispatches  LogisticsOutboundDispatch[]
  logisticsWarehouseHandlings  LogisticsWarehouseHandling[]
  logisticsStatutoryDocs       LogisticsStatutoryDoc[]
  logisticsFleetMaintenances   LogisticsFleetMaintenance[]
  logisticsFreightAudits       LogisticsFreightAudit[]

  // Gate Security Department Multi-Tenant Entities (Strict Company Isolation)
  gateVehicleEntries           GateVehicleEntry[]
  gateVisitorAccesses          GateVisitorAccess[]
  gateMaterialInspections      GateMaterialInspection[]
  gateTrafficParkings          GateTrafficParking[]
  gateEmergencyControls        GateEmergencyControl[]
  gateNightPatrols             GateNightPatrol[]

  @@index([gstNumber])
  @@index([industryCategory])
  @@map("companies")
}

model User {
  id           String    @id @default(uuid())
  employeeCode String?   // e.g. "EMP-PROD-001", "STEE-WB-001", or "GLAS-BH-001"
  email        String    @unique
  username     String?   @unique
  password     String    // Hashed with bcrypt
  firstName    String?
  lastName     String?
  phone        String?

  // RBAC Department, Designation & Role Hierarchy
  // Strict Multi-Tenancy Roles (Each registered company has its own independent, fully isolated set of these roles):
  // - Common Tenant Roles: SUPER_ADMIN, EXECUTIVE, PRODUCTION, QUALITY, INVENTORY, PROCUREMENT, SALES, FINANCE, HR, MACHINE_MAINTENANCE, LOGISTICS, GATE_SECURITY
  // Standard 10 core manufacturing departments + 34 sector-specific specialized roles:
  // Heavy & Raw Materials / Steel & Heavy metals:
  // 1. WEIGHBRIDGE_LOGISTICS_MANAGER
  // 2. METALLURGY_LAB_INCHARGE
  // 3. SUBCONTRACTING_JOBWORK_MANAGER
  // 4. EHS_SAFETY_MANAGER
  // Heavy & Raw Materials / Glass & Ceramic Production:
  // 5. BATCH_HOUSE_MANAGER
  // 6. KILN_FURNACE_MANAGER
  // 7. MOULD_TOOLING_MANAGER
  // 8. THERMAL_QUALITY_INCHARGE
  // 9. CULLET_RECOVERY_MANAGER
  // Process & Chemical Industries / Chemical:
  // 10. RD_FORMULA_CHEMIST_MANAGER
  // 11. EHS_HAZMAT_MANAGER
  // 12. QA_ANALYTICAL_LAB_MANAGER
  // 13. REACTOR_BATCH_PRODUCTION_MANAGER
  // 14. HAZARDOUS_LOGISTICS_MANAGER
  // Process & Chemical Industries / Paint:
  // 15. COLOR_LAB_SHADE_MANAGER
  // 16. PIGMENT_RESIN_DISPERSION_MANAGER
  // 17. QUALITY_RHEOLOGY_MANAGER
  // 18. BASE_STOCK_TINTING_MANAGER
  // 19. FLAMMABLE_PACKAGING_COMPLIANCE_MANAGER
  // Process & Chemical Industries / Rubber & Tyre:
  // 20. RUBBER_COMPOUNDING_MANAGER
  // 21. EXTRUSION_CALENDERING_MANAGER
  // 22. TYRE_BUILDING_MANAGER
  // 23. CURING_VULCANIZATION_MANAGER
  // 24. TYRE_TESTING_UNIFORMITY_MANAGER
  // Chemical Industries / Pipes:
  // 25. EXTRUSION_LINE_OPERATIONS_MANAGER
  // 26. WALL_THICKNESS_QUALITY_INCHARGE
  // 27. HYDROSTATIC_BURST_TESTING_MANAGER
  // 28. SOCKETING_BELLING_JOINTING_MANAGER
  // 29. PVC_DRY_BLEND_REGRIND_MANAGER
  // Engineering, Machinery and Electronics / Automobiles:
  // 30. JIT_JIS_SUPPLY_CHAIN_MANAGER
  // 31. PRESS_SHOP_BIW_MANAGER
  // 32. VEHICLE_ASSEMBLY_MANAGER
  // 33. PAINT_SHOP_ANTI_CORROSION_MANAGER
  // 34. EOL_TESTING_VIN_MANAGER
  // Engineering, Machinery and Electronics / Electronical:
  // 35. SMT_PCB_ASSEMBLY_MANAGER
  // 36. ELECTRICAL_TESTING_CALIBRATION_MANAGER
  // 37. FIRMWARE_FLASHING_MANAGER
  // 38. COMPONENT_OBSOLESCENCE_EBOM_MANAGER
  // 39. ESD_CLEANROOM_COMPLIANCE_MANAGER
  // Engineering, Machinery and Electronics / Electric Equipment:
  // 40. WINDING_COIL_FABRICATION_MANAGER
  // 41. CORE_ASSEMBLY_LAMINATION_MANAGER
  // 42. VPI_INSULATION_MANAGER
  // 43. HV_ROUTINE_TESTING_MANAGER
  // 44. BUSBAR_FABRICATION_ENCLOSURE_MANAGER
  // Consumer Goods / Leather:
  // 45. HIDE_WETBLUE_MANAGER
  // 46. RETANNING_DYEING_CRUST_MANAGER
  // 47. SPLITTING_SHAVING_CALIBRATION_MANAGER
  // 48. FINISHING_BUFFING_EMBOSSING_MANAGER
  // 49. LEATHER_QC_AREA_MEASUREMENT_MANAGER
  // Consumer Goods / Furniture:
  // 50. TIMBER_SEASONING_KILN_MANAGER
  // 51. DIMENSION_MILL_CNC_MANAGER
  // 52. UPHOLSTERY_FOAM_CUTTING_MANAGER
  // 53. SANDING_FINISHING_POLISHING_MANAGER
  // 54. KD_PACKAGING_HARDWARE_KITTING_MANAGER
  // Food Manufacturing / Dairy Product:
  // 55. MILK_COLLECTION_RECEPTION_MANAGER
  // 56. PASTEURIZATION_PROCESSING_MANAGER
  // 57. FERMENTATION_CULTURE_MANAGER
  // 58. QA_MBRT_ANTIBIOTIC_INCHARGE
  // 59. COLD_CHAIN_EXPIRY_MANAGER
  department   String    @default("PRODUCTION")
  designation  String    @default("ASSOCIATE_MANAGER")
  role         String    @default("PRODUCTION_ASSOCIATE_MANAGER")

  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  // Organization Association (Strict Multi-Tenancy: Every user is strictly bound to a companyId)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Super Admin Governance & Payroll Relations
  employeePayrolls   EmployeePayroll[]
  auditLogs          AuditLog[]
  requestedApprovals ApprovalRequest[] @relation("RequesterApprovals")
  reviewedApprovals  ApprovalRequest[] @relation("ReviewerApprovals")

  // Quality Department Hierarchical Task Relations
  assignedQualityTasks QualityTask[] @relation("QualityTaskAssignee")
  createdQualityTasks  QualityTask[] @relation("QualityTaskAssigner")

  // Inventory Department Hierarchical Task Relations
  assignedInventoryTasks InventoryTask[] @relation("InventoryTaskAssignee")
  createdInventoryTasks  InventoryTask[] @relation("InventoryTaskAssigner")

  // Finance Department Hierarchical Task Relations
  assignedFinanceTasks   FinanceTask[]   @relation("FinanceTaskAssignee")
  createdFinanceTasks    FinanceTask[]   @relation("FinanceTaskAssigner")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([username])
  @@index([companyId])
  @@index([companyId, department])
  @@index([companyId, role])
  @@index([role])
  @@map("users")
}

// =========================================================================
// Steel & Heavy Metals Specialized Operational Entities
// =========================================================================

model WeighbridgeSlip {
  id              String   @id @default(uuid())
  slipNumber      String   @unique
  truckNumber     String
  driverName      String?
  driverPhone     String?
  supplierOrBuyer String
  materialName    String
  poNumber        String?
  invoiceNumber   String?
  grossWeight     Float
  tareWeight      Float
  netWeight       Float
  unit            String   @default("MT")
  approvalStatus  String   @default("PENDING")
  approvedById    String?
  approvalNotes   String?

  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([truckNumber])
  @@index([approvalStatus])
  @@map("weighbridge_slips")
}

model MetallurgyHeatTest {
  id                  String   @id @default(uuid())
  heatNumber          String
  grade               String
  batchNumber         String?
  sampleDate          DateTime @default(now())

  carbon              Float?
  manganese           Float?
  silicon             Float?
  sulphur             Float?
  phosphorus          Float?
  chromium            Float?

  yieldStrength       Float?
  tensileStrength     Float?
  elongation          Float?

  testPassed          Boolean  @default(true)
  mtcNumber           String?  @unique
  approvalStatus      String   @default("APPROVED")
  approvedById        String?
  labTechnicianNotes  String?

  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
  @@index([heatNumber])
  @@index([mtcNumber])
  @@map("metallurgy_heat_tests")
}

model SubcontractingChallan {
  id                  String   @id @default(uuid())
  challanNumber       String   @unique
  vendorName          String
  vendorGst           String?
  processType         String
  materialSent        String
  sentWeight          Float
  receivedWeight      Float?
  scrapReturnedWeight Float?
  weightLossGain      Float?
  lossGainPercentage  Float?
  status              String   @default("ISSUED")
  reconciledById      String?
  reconciliationNotes String?

  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
  @@index([challanNumber])
  @@index([status])
  @@map("subcontracting_challans")
}

model EhsIncidentRecord {
  id                     String    @id @default(uuid())
  recordNumber           String    @unique
  incidentType           String
  severity               String    @default("MEDIUM")
  plantLocation          String
  description            String
  correctiveAction       String?
  hotWorkPermitRequired  Boolean   @default(false)
  hotWorkPermitApproved  Boolean   @default(false)
  permitValidUntil       DateTime?
  auditedById            String?
  complianceStatus       String    @default("COMPLIANT")

  companyId              String
  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([companyId])
  @@index([incidentType])
  @@index([severity])
  @@map("ehs_incident_records")
}

// =========================================================================
// Glass & Ceramic Production Specialized Operational Entities
// =========================================================================

// 
// 1. Batch House Formula & Mix Weighing Log
// Governed by BATCH_HOUSE_MANAGER:
// - Recipe/formula master data (Silica Sand, Soda Ash, Limestone, Feldspar, Dolomite)
// - Internal & external cullet recycled ratio tracking (% of total batch)
// - Silo & hopper inventory levels tracking
//
model GlassBatchFormula {
  id                 String   @id @default(uuid())
  formulaCode        String   @unique // e.g. "FORM-FLT-2026-01"
  batchName          String   // e.g. "Clear Soda-Lime Float Glass 4mm"
  glassType          String   // Float Glass, Container Glass, Borosilicate, Vitrified Ceramic
  silicaSandWeight   Float    // kg / MT per batch
  sodaAshWeight      Float    // kg / MT
  limestoneWeight    Float    // kg / MT
  feldsparWeight     Float?   // kg / MT
  dolomiteWeight     Float?   // kg / MT
  culletWeight       Float    // Recycled cullet (internal + external scrap)
  totalBatchWeight   Float    // Total calculated weight
  culletRatioPercent Float    // Cullet percentage: (culletWeight / totalBatchWeight) * 100
  siloHopperLevels   String?  // JSON string of silo fill levels (% capacity)
  status             String   @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  approvedById       String?

  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
  @@index([formulaCode])
  @@map("glass_batch_formulas")
}

// 
// 2. Kiln & Furnace Telemetry & Burner Maintenance Log
// Governed by KILN_FURNACE_MANAGER:
// - Melting, refining & annealing lehr temperature zones (°C)
// - Fuel/natural gas consumption per metric ton of melted glass
// - Burner nozzle maintenance & thermal shock parameters
//
model KilnFurnaceLog {
  id                     String   @id @default(uuid())
  furnaceId              String   // e.g. "MELTER-LINE-01"
  logTimestamp           DateTime @default(now())
  meltingZoneTemp        Float    // e.g. 1580.0 °C
  refiningZoneTemp       Float    // e.g. 1420.0 °C
  annealingLehrTemp      Float    // e.g. 550.0 °C
  gasConsumptionCubicMtr Float    // Total gas / fuel consumed
  fuelPerTonGlass        Float?   // Specific energy consumption (Nm³/ton)
  burnerMaintenanceDue   Boolean  @default(false)
  crownPressureMmWg      Float?   // Crown pressure mm water gauge
  thermalShockDeltaT     Float?   // Temperature gradient parameter (°C)
  operatorNotes          String?
  loggedById             String?

  companyId              String
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([companyId])
  @@index([furnaceId])
  @@map("kiln_furnace_logs")
}

// 
// 3. Mould & Tooling Life Cycle Tracking Record
// Governed by MOULD_TOOLING_MANAGER:
// - Mould/die shot counts and run hours
// - Precision machining, cavity polishing, and refurbishment scheduling
// - Tooling line allocation & replacement alerts
//
model MouldToolingRecord {
  id                  String    @id @default(uuid())
  mouldCode           String    @unique // e.g. "MLD-BTL-750-A"
  mouldType           String    // Blow Mould, Blank Mould, Press Die, Ceramic Tile Die
  materialType        String    @default("Cast Iron / Bronze Alloy")
  cavityCount         Int       @default(1)
  currentShotCount    Int       @default(0) // Total cycles / shots produced
  maxShotLife         Int       @default(250000) // Rated shot life before scrapping
  remainingLifePercent Float    @default(100.0) // 100 - (currentShotCount / maxShotLife * 100)
  lastPolishedAt      DateTime?
  nextMaintenanceDue  DateTime?
  status              String    @default("ACTIVE") // ACTIVE, REFURBISHMENT_DUE, SCRAPPED
  allocatedLine       String?   // e.g. "IS Machine Line 3"
  notes               String?

  companyId           String
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId])
  @@index([mouldCode])
  @@index([status])
  @@map("mould_tooling_records")
}

// 
// 4. Thermal Quality, Optical Defect & Strength Test
// Governed by THERMAL_QUALITY_INCHARGE:
// - Surface defect inspections: bubbles/seeds, stones, cord lines, pinholes, warping (mm/m)
// - Thermal shock endurance test (cold/hot water quench)
// - Internal stress polarimeter examination & lot release clearance
//
model ThermalQualityInspection {
  id                     String   @id @default(uuid())
  lotNumber              String   @unique // e.g. "LOT-GLAS-2026-089"
  productType            String   // Architectural Float, Container Bottle, Ceramic Floor Tile
  inspectedSampleCount   Int      @default(100)
  defectBubblesSeeds     Int      @default(0) // Bubble count per m² / per batch
  defectPinholesStones   Int      @default(0)
  defectWarpingMm        Float    @default(0.0) // Warping or dimensional flatness deviation in mm
  thermalShockTestPassed Boolean  @default(true) // Withstood 40°C - 50°C delta T quench
  thermalShockDeltaT     Float    @default(45.0) // Tested delta T in °C
  impactStrengthJoules   Float?   // Mechanical strength / fracture resistance
  lotStatus              String   @default("APPROVED") // APPROVED, HOLD, REJECTED
  inspectorNotes         String?
  inspectorId            String?

  companyId              String
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([companyId])
  @@index([lotNumber])
  @@index([lotStatus])
  @@map("thermal_quality_inspections")
}

// 
// 5. Cullet Scrap Recovery & Mass Balance Reconciliation
// Governed by CULLET_RECOVERY_MANAGER:
// - Stage-wise rejection tracking (Hot End, Annealing Lehr, Cold End packaging)
// - Scrap cullet recovery percentages calculation
// - Raw material input vs finished pack output mass balance reconciliation
//
model CulletRecoveryRecord {
  id                     String   @id @default(uuid())
  recordNumber           String   @unique // e.g. "REC-CUL-2026-042"
  shiftDate              DateTime @default(now())
  productionLine         String   // e.g. "Float Line 1"
  hotEndRejectionWeight  Float    // Weight of molten / shear scrap cullet (MT)
  coldEndRejectionWeight Float    // Weight of packing / optical reject cullet (MT)
  totalRejectionWeight   Float    // hotEnd + coldEnd (MT)
  recoveredCulletWeight  Float    // Weight crushed and returned to batch house (MT)
  recoveryPercentage     Float    // (recoveredCulletWeight / totalRejectionWeight) * 100
  massBalanceLossPercent Float    // Unaccounted furnace volatilization / dusting loss %
  reconciledById         String?
  reconciliationNotes    String?

  companyId              String
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([companyId])
  @@index([recordNumber])
  @@map("cullet_recovery_records")
}

// =========================================================================
// Process & Chemical Industries / Chemical Specialized Operational Entities
// =========================================================================

// 
// 1. Master Formula & Chemical Stoichiometry
// Governed by RD_FORMULA_CHEMIST_MANAGER:
// - Master formula versioning and reaction stoichiometry
// - Theoretical vs actual isolated stoichiometric yield calculations
// - New formulation authorization and hazard classifications
//
model ChemicalFormulaMaster {
  id                      String   @id @default(uuid())
  formulaCode             String   @unique // e.g. "FORM-CHEM-2026-001"
  productName             String   // e.g. "Polyurethane Resin Precursor / Ethyl Acetate Reagent"
  version                 String   @default("v1.0") // e.g. "v2.4"
  stoichiometryEquation   String   // e.g. "C6H12O6 + 6O2 -> 6CO2 + 6H2O" or "R-OH + R'-COOH <-> R'-COO-R + H2O"
  theoreticalYieldKg      Float    // Stoichiometric theoretical maximum yield (kg)
  expectedCycleTimeHours  Float    @default(8.0)
  reactionType            String   // Exothermic Synthesis, Esterification, Polymerization, Halogenation, Distillation
  hazardClassification    String   @default("CLASS_3_FLAMMABLE") // CLASS_3_FLAMMABLE, CORROSIVE, TOXIC, OXIDIZING
  activeStatus            String   @default("APPROVED") // DRAFT, UNDER_REVIEW, APPROVED, ARCHIVED
  rawMaterialsComposition String   // JSON string of reactants, molar ratios, and CAS numbers
  safetyDataSheetUrl      String?  // SDS reference / URL
  authorizedById          String?
  authorizationNotes      String?

  companyId               String
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([companyId])
  @@index([formulaCode])
  @@index([activeStatus])
  @@map("chemical_formula_masters")
}

// 
// 2. Hazardous Waste Disposal & Safety Compliance Manifests
// Governed by EHS_HAZMAT_MANAGER:
// - Hazardous waste disposal logs with UN classifications
// - PPE compliance audits & safety scores
// - Chemical handling permits & regulatory board reporting
//
model ChemicalHazmatRecord {
  id                       String   @id @default(uuid())
  manifestNumber           String   @unique // e.g. "HAZ-MAN-2026-118"
  wasteType                String   // Spent Solvent, Distillation Bottom Sludge, Toxic Heavy Metal Effluent, Acid Wash
  unClassification         String   @default("UN 1993") // e.g. "UN 1993", "UN 1760", "UN 3082"
  wasteCategoryCpcb        String   // e.g. "Category 20.2 (Spent Solvents)", "Category 28.1 (Residues)"
  quantityLtrOrKg          Float    // Quantity
  unit                     String   @default("kg") // "kg", "ltr", "MT"
  disposalMethod           String   // Authorized TSDF Incineration, In-house Solvent Recovery, Secured Landfill
  handlingPermitNumber     String   // e.g. "PCB-HAZ-AUTH-2026-9021"
  permitExpiryDate         DateTime?
  ppeComplianceStatus      String   @default("COMPLIANT") // COMPLIANT, WARNING, FLAGGED_VIOLATION
  ppeAuditScore            Float    @default(98.5) // 0-100% audit score
  statutoryRegulatoryBody  String   @default("CPCB / SPCB")
  safetyAuditDate          DateTime @default(now())
  auditorOfficerId         String?
  auditNotes               String?

  companyId                String
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([companyId])
  @@index([manifestNumber])
  @@index([ppeComplianceStatus])
  @@map("chemical_hazmat_records")
}

// 
// 3. Analytical Laboratory Tests & Batch Clearance Gate
// Governed by QA_ANALYTICAL_LAB_MANAGER:
// - Analytical test uploads (Purity %, pH, Karl Fischer moisture, Density)
// - Strict dispatch blocking if quality parameters fail
// - Auto-generation of Certificate of Analysis (CoA)
//
model AnalyticalLabTest {
  id                   String   @id @default(uuid())
  testId               String   @unique // e.g. "LAB-QA-2026-554"
  batchNumber          String   // e.g. "BATCH-CHEM-2026-081"
  productName          String   // Product under assay
  sampleSource         String   // Reactor Output, Distillate Cut, Storage Tank, Packaged Drum
  purityPercent        Float    // Assay Purity (e.g. 99.4%)
  phLevel              Float    // pH (e.g. 7.2)
  moistureWaterPercent Float    // Karl Fischer moisture titration (e.g. 0.08%)
  densityGml           Float?   // Specific gravity / density g/mL (e.g. 0.902)
  testPassed           Boolean  @default(true) // Pass/Fail criteria
  dispatchCleared      Boolean  @default(false) // CRITICAL GATE: Unapproved batches blocked from dispatch
  coaDocumentNumber    String?  @unique // Auto-generated CoA (e.g. "COA-2026-9921")
  coaGeneratedAt       DateTime?
  blockingReason       String?  // Reason if dispatchCleared is false
  chemistSignoffId     String?
  chemistNotes         String?

  companyId            String
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([companyId])
  @@index([testId])
  @@index([batchNumber])
  @@index([dispatchCleared])
  @@map("analytical_lab_tests")
}

// 
// 4. Reactor Batch Cycles & Utility Monitoring
// Governed by REACTOR_BATCH_PRODUCTION_MANAGER:
// - Stage tracking: CHARGING, REACTION, REFLUX, DISTILLATION, COOLING, DISCHARGING, COMPLETED
// - Utility duty tracking: steam, cooling water, electrical power
// - Isolated yield vs target & equipment downtime tracking
//
model ReactorBatchCycle {
  id                  String   @id @default(uuid())
  batchCode           String   @unique // e.g. "BAT-R4-2026-092"
  reactorId           String   // e.g. "GLR-101 (Glass Lined Reactor 5000L)" or "SS-202 (Stainless Steel 316L)"
  productName         String
  currentStage        String   @default("CHARGING") // CHARGING, REACTION, REFLUX, DISTILLATION, COOLING, DISCHARGING, COMPLETED
  targetYieldKg       Float    // Theoretical or recipe target (kg)
  actualYieldKg       Float    @default(0.0) // Actual isolated yield (kg)
  yieldPercentage     Float    @default(0.0) // (actualYieldKg / targetYieldKg) * 100
  steamConsumptionKg  Float    @default(0.0) // Steam duty (kg)
  coolingWaterM3      Float    @default(0.0) // Cooling water circulation (m³)
  powerConsumptionKwh Float    @default(0.0) // Electrical energy (kWh)
  cycleStartTime      DateTime @default(now())
  cycleEndTime        DateTime?
  downtimeHours       Float    @default(0.0) // Recorded downtime in hours
  downtimeReason      String?  // Maintenance, jacket leak, power trip, condenser fouling
  operatorInchargeId  String?
  stageRemarks        String?

  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
  @@index([batchCode])
  @@index([currentStage])
  @@map("reactor_batch_cycles")
}

// 
// 5. Dangerous Goods Logistics, Tremcards & Statutory Permits
// Governed by HAZARDOUS_LOGISTICS_MANAGER:
// - Dangerous goods transit documentation (UN Number, Hazchem code, Tremcards)
// - Driver Hazchem endorsement & vehicle fitness validation
// - Statutory transit permit renewals & transport dispatch gate
//
model DangerousGoodsLogistics {
  id                            String    @id @default(uuid())
  dispatchTrackingNumber        String    @unique // e.g. "DGL-2026-339"
  batchNumber                   String    // e.g. "BATCH-CHEM-2026-081"
  productName                   String
  unNumber                      String    @default("UN 1993") // e.g. "UN 1993"
  properShippingName            String    // e.g. "FLAMMABLE LIQUID, N.O.S. (Toluene Solution)"
  hazardClass                   String    @default("Class 3 (Flammable Liquid)") // e.g. Class 3, Class 8 (Corrosive), Class 6.1 (Toxic)
  packingGroup                  String    @default("PG II") // PG I (Great Danger), PG II (Medium Danger), PG III (Minor Danger)
  hazchemCode                   String    @default("3YE") // Hazchem emergency code e.g. 3YE, 2WE
  tremcardIssued                Boolean   @default(true) // Transport Emergency Card issued to driver
  tremcardDocumentNumber        String?   // e.g. "TREM-2026-8812"
  vehicleRegistrationNumber     String    // e.g. "MH-12-RN-8842" (ADR / Hazmat approved vehicle)
  driverName                    String
  driverLicenseNumber           String
  driverHazmatEndorsementValid  Boolean   @default(true) // Valid Hazchem certified commercial endorsement
  driverLicenseExpiryDate       DateTime?
  statutoryTransitPermitNumber  String?   // State or Petroleum & Explosives Safety Org (PESO) permit
  statutoryPermitExpiry         DateTime?
  routeClearanceStatus          String    @default("APPROVED") // APPROVED, PENDING_AUDIT, EXPIRED_LICENSE_HOLD
  dispatchNotes                 String?
  logisticsInchargeId           String?

  companyId                     String
  company                       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@index([companyId])
  @@index([dispatchTrackingNumber])
  @@index([unNumber])
  @@index([routeClearanceStatus])
  @@map("dangerous_goods_logistics")
}

// =========================================================================
// PROCESS & CHEMICAL INDUSTRIES / PAINT SPECIALIZED OPERATIONAL MODELS
// =========================================================================

// 
// 1. Master Shade Cards, Spectrophotometer Delta E & Tinting Formulas
// Governed by COLOR_LAB_SHADE_MANAGER:
// - Master shade cards and custom tinting formula approvals
// - Spectrophotometer L*a*b* reading integration
// - Delta E tolerance limit validation (spec: delta E <= 0.50)
//
model PaintShadeMaster {
  id                        String    @id @default(uuid())
  shadeCode                 String    @unique // e.g. "SHADE-PNT-2026-104"
  shadeName                 String    // e.g. "Royal Venetian Blue 202"
  colorFamily               String    // e.g. "Blue", "Off-White", "Terracotta", "Pastel"
  baseTypeRequired          String    @default("WHITE_BASE") // "WHITE_BASE", "DEEP_BASE", "CLEAR_BASE", "YELLOW_BASE"
  spectroL                  Float     @default(42.50) // Spectrophotometer L* (lightness 0-100)
  spectroA                  Float     @default(-8.20) // Spectrophotometer a* (-green to +red)
  spectroB                  Float     @default(-32.40) // Spectrophotometer b* (-blue to +yellow)
  targetDeltaETolerance     Float     @default(0.50) // Maximum allowable delta E color difference tolerance
  customTintingFormulaJson  String?   // JSON recipe of colorant shots (e.g. Lamp Black 12.5ml, Phthalo Blue 45.0ml per 1L)
  formulaApproved           Boolean   @default(true) // Color Lab sign-off
  approvedBy                String?   // e.g. "COLOR_LAB_SHADE_MANAGER"
  status                    String    @default("ACTIVE") // ACTIVE, UNDER_REVIEW, OBSOLETE

  companyId                 String
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([companyId])
  @@index([shadeCode])
  @@index([colorFamily])
  @@map("paint_shade_masters")
}

// 
// 2. Pigment & Resin Dispersion Grinding Batches
// Governed by PIGMENT_RESIN_DISPERSION_MANAGER:
// - Sand/bead mill grinding batch cycle tracking
// - Mill base viscosity monitoring (KU)
// - 5-stage raw material loading sequence (Resin -> Solvents -> Wetting Additives -> Pigments -> Extenders)
// - Mill chamber run-hours and cooling telemetry
//
model PaintDispersionBatch {
  id                          String    @id @default(uuid())
  batchCode                   String    @unique // e.g. "DISP-BM4-2026-081"
  millId                      String    // e.g. "Bead Mill BM-04 (Horizontal Dyno-Mill 50L)"
  productName                 String    // e.g. "High Gloss Alkyd Enamel Mill Base"
  resinType                   String    // e.g. "Medium Oil Alkyd 60%", "Pure Acrylic Emulsion", "Epoxy Resin 70%"
  pigmentType                 String    // e.g. "Rutile Titanium Dioxide (TiO2)", "Carbon Black", "Phthalo Cyanine"
  targetViscosityKu           Float     // e.g. 95.0 KU
  currentViscosityKu          Float     // e.g. 98.5 KU
  loadingSequenceCompleted    Boolean   @default(true) // Resins -> Solvents -> Wetting Additives -> Pigments -> Extenders verified
  grindingDurationMinutes     Int       @default(120) // Mill dwell / grinding time
  beadMillRunHours            Float     @default(4.5) // Total run hours on grinding beads & zirconium discs
  coolingWaterTempCelsius     Float     @default(22.0) // Cooling jacket temperature to avoid pigment thermal shock
  dispersionStatus            String    @default("COMPLETED") // PRE_MIXING, MILLING, VISCOSITY_CHECK, COMPLETED
  operatorNotes               String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([batchCode])
  @@index([millId])
  @@map("paint_dispersion_batches")
}

// 
// 3. Quality Rheology, Fineness & Automated Packaging Gate
// Governed by QUALITY_RHEOLOGY_MANAGER:
// - Stormer Krebs Viscosity (KU) and specific gravity density testing
// - Hegman gauge fineness of grind (microns)
// - Touch dry and hard dry film formation times
// - Strict Packaging Gate: fails if KU < 85 or > 115, fineness > 25um, or touch dry > 60min
// - Automated Certificate of Analysis (CoA) generation
//
model PaintRheologyTest {
  id                        String    @id @default(uuid())
  testId                    String    @unique // e.g. "RHEO-2026-401"
  batchNumber               String    // e.g. "BATCH-PNT-2026-092"
  productName               String    // e.g. "Premium Acrylic Interior Emulsion"
  krebsViscosityKu          Float     // Stormer Krebs Viscosity (spec: 85.0 - 115.0 KU)
  densityGml                Float     // Specific Gravity / Density g/mL (spec: 1.25 - 1.40)
  hegmanFinenessMicrons     Float     // Hegman grind gauge (spec: <= 25.0 microns / >= 7 Hegman)
  touchDryMinutes           Int       // Touch dry time in minutes (spec: <= 45 min)
  hardDryMinutes            Int       // Hard dry time in minutes (spec: <= 240 min)
  glossLevel60Deg           Float?    // 60-degree specular gloss in GU (spec e.g. 85+ for high gloss, <10 for matte)
  packagingCleared          Boolean   @default(true) // STRICT GATE: failing batches blocked from canning lines
  coaDocumentNumber         String?   // e.g. "COA-PNT-2026-1044"
  coaGeneratedAt            DateTime?
  rejectionReason           String?
  qaChemistNotes            String?

  companyId                 String
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([companyId])
  @@index([testId])
  @@index([batchNumber])
  @@index([packagingCleared])
  @@map("paint_rheology_tests")
}

// 
// 4. Bulk Base Stock & Automatic Colorant Dispenser Tinting
// Governed by BASE_STOCK_TINTING_MANAGER:
// - Bulk base tank storage levels (Base White, Deep Base, Clear Base)
// - Automatic computer-controlled dispenser calibration & shots
// - Stage-wise colorant shot consumption reconciliation
//
model PaintBaseStockTinting {
  id                        String    @id @default(uuid())
  dispenseTrackingNumber    String    @unique // e.g. "TNT-2026-883"
  baseTankId                String    // e.g. "Bulk Storage Tank BT-101 (Base White 15,000L)"
  baseType                  String    // "BASE_WHITE", "DEEP_BASE", "CLEAR_BASE", "TRANSPARENT"
  dispenserMachineId        String    // e.g. "Fast & Fluid Auto-Tint Dispenser AT-02"
  targetVolumeLtr           Float     // e.g. 500.0 Liters
  colorantWhiteMl           Float     @default(0.0) // Colorant shot consumption in mL
  colorantBlackMl           Float     @default(0.0)
  colorantYellowOxideMl     Float     @default(0.0)
  colorantRedOxideMl        Float     @default(0.0)
  colorantPhthaloBlueMl     Float     @default(0.0)
  colorantPhthaloGreenMl    Float     @default(0.0)
  reconciliationStatus      String    @default("RECONCILED") // RECONCILED, DISCREPANCY_FLAGGED, PENDING_AUDIT
  variancePercentage        Float     @default(0.12) // Percentage variance between dispenser load cell & inventory ledger
  operatorNotes             String?

  companyId                 String
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([companyId])
  @@index([dispenseTrackingNumber])
  @@index([baseTankId])
  @@map("paint_base_stock_tintings")
}

// 
// 5. Flammable Solvent Packaging & Container Safety Compliance
// Governed by FLAMMABLE_PACKAGING_COMPLIANCE_MANAGER:
// - Container inventory management (1L, 4L, 10L, 20L cans/buckets)
// - Batch numbering, MFD, and shelf-life code printing verification
// - Volatile Organic Compounds (VOC) content regulatory compliance
// - Solvent warehouse earthing / anti-static bonding verification
//
model PaintPackagingCompliance {
  id                          String    @id @default(uuid())
  packLotNumber               String    @unique // e.g. "LOT-PKG-2026-772"
  batchNumber                 String    // e.g. "BATCH-PNT-2026-092"
  productName                 String    // e.g. "Synthetic High Gloss Enamel"
  containerSize               String    // "1L", "4L", "10L", "20L"
  containerType               String    // "TIN_CAN", "HDPE_BUCKET", "STEEL_DRUM"
  quantityContainers          Int       // e.g. 450 units
  mfgDate                     DateTime  @default(now())
  expDate                     DateTime  // Mfg + shelfLifeMonths
  shelfLifeMonths             Int       @default(36) // 36 months standard
  batchCodePrinted            String    // Lid imprint: "B.No: BATCH-092 | MFD: 11/26 | USE BY: 11/29"
  vocContentGramsPerLiter     Float     @default(48.5) // Volatile Organic Compounds (spec <= 50 g/L for green building compliance)
  antiStaticBondingVerified   Boolean   @default(true) // Solvent filling grounding/earthing safety check
  flammableSolventPermitValid Boolean   @default(true) // Factory inspectorate solvent warehouse compliance
  warehouseLocationBay        String    @default("Bay-Solvent-FL-02")
  complianceSignOff           String    @default("COMPLIANT") // COMPLIANT, NON_COMPLIANT_HOLD

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([packLotNumber])
  @@index([batchNumber])
  @@map("paint_packaging_compliances")
}

// =========================================================================
// Rubber & Tyre Specialized Operational Entities
// =========================================================================

// 
// 1. Multi-Stage Rubber Compounding & Rheometer / Mooney Viscosity
// Governed by RUBBER_COMPOUNDING_MANAGER:
// - Multi-stage compounding recipe management (Masterbatch, Remix, Final Mix)
// - Mooney viscosity ML (1+4) at 100°C tracking
// - Carbon black dispersion parameter logs (ASTM D7723 / Phillips rating)
// - Batch-wise ingredient traceability (Polymers NR/SBR/BR, Carbon Black, Curatives)
//
model RubberCompoundingBatch {
  id                            String    @id @default(uuid())
  batchNumber                   String    @unique // e.g. "CMP-2026-901"
  compoundGrade                 String    // e.g. "Tread Cap SBR/BR 1502 High Silica"
  stage                         String    @default("FINAL_MIX") // MASTER_BATCH, REMIX, FINAL_MIX
  recipeVersion                 String    // e.g. "REC-TRD-V4.2"
  polymerType                   String    // e.g. "NR/BR/SBR Blend"
  mooneyViscosityML             Float     // e.g. 56.5 Mooney Units (ML 1+4 @ 100°C)
  carbonBlackDispersionPercent  Float     // e.g. 98.2% dispersion score
  batchWeightKg                 Float     // e.g. 240.0 kg
  mixingTimeSeconds             Int       // e.g. 280 seconds
  dumpTemperatureCelsius        Float     // e.g. 155.0 °C
  curativesAdded                Boolean   @default(true)
  traceabilityLotNumbers        String?   // Raw material lots, e.g. "NR-LOT-441, CB-N220-881, S-ACC-902"
  approvalStatus                String    @default("APPROVED") // APPROVED, ON_HOLD, REJECTED
  testedBy                      String?
  notes                         String?

  companyId                     String
  company                       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@index([companyId])
  @@index([batchNumber])
  @@map("rubber_compounding_batches")
}

// 
// 2. Extrusion & Calendering Line Profile Monitoring
// Governed by EXTRUSION_CALENDERING_MANAGER:
// - Extrusion die profile & temperature monitoring across thermal zones
// - Steel cord / fabric tension (kN) and gauge thickness (mm) tracking
// - Roll stock inventory management and roll weight tracking
//
model ExtrusionCalenderingLog {
  id                      String    @id @default(uuid())
  runNumber               String    @unique // e.g. "EXT-CAL-2026-441"
  lineType                String    // EXTRUSION_TREAD_SIDEWALL, CALENDER_STEEL_CORD, CALENDER_TEXTILE_FABRIC, INNER_LINER_CALENDER
  dieProfileCode          String    // e.g. "DIE-TRD-205/55R16-P1"
  targetThicknessMm       Float     // e.g. 8.50 mm
  actualThicknessMm       Float     // e.g. 8.48 mm
  gaugeToleranceMm        Float     @default(0.15) // ± tolerance
  temperatureZoneCelsius  Float     // e.g. 98.5 °C
  tensionKiloNewton       Float?    // e.g. 4.8 kN steel cord tension
  rollStockNumber         String    // e.g. "ROLL-CRD-8820"
  rollLengthMeters        Float     // e.g. 450.0 meters
  rollWeightKg            Float     // e.g. 620.0 kg
  lineSpeedMpm            Float     @default(25.0) // Meters per minute
  complianceStatus        String    @default("IN_SPEC") // IN_SPEC, OUT_OF_SPEC_HOLD, ADJUSTMENT_REQUIRED
  operatorNotes           String?

  companyId               String
  company                 Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([companyId])
  @@index([runNumber])
  @@map("extrusion_calendering_logs")
}

// 
// 3. Green Tyre Assembly Sequence & WIP Tracking
// Governed by TYRE_BUILDING_MANAGER:
// - Green tire assembly sequence tracking (Carcass ply, belt package, tread application)
// - Component bill of materials (BOM) management
// - Green tire work-in-progress (WIP) stock monitoring
//
model TyreBuildingRecord {
  id                    String    @id @default(uuid())
  buildBarcode          String    @unique // e.g. "GT-2026-00892"
  tyreSizePattern       String    // e.g. "205/55 R16 Tubeless Radial 91V"
  buildingMachineId     String    // e.g. "TBM-Unistage-03"
  assemblyStage         String    @default("COMPLETED") // CARCASS_PLY, BELT_PACKAGE, TREAD_APPLICATION, SHAPING_CONSOLIDATION, COMPLETED
  bomRecipeId           String    // e.g. "BOM-TYR-2055516-V3"
  innerLinerLot         String?
  carcassPlyLot         String?
  steelBeltLot          String?
  treadExtrusionLot     String?
  beadAssemblyLot       String?
  greenTyreWeightKg     Float     // e.g. 8.85 kg
  wipLocationBay        String    @default("Bay-GT-R16-04")
  inspectionStatus      String    @default("PASSED") // PASSED, REWORK, REJECTED
  operatorId            String?

  companyId             String
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId])
  @@index([buildBarcode])
  @@map("tyre_building_records")
}

// 
// 4. Curing & Vulcanization Press Monitoring & Bladder Lifecycle
// Governed by CURING_VULCANIZATION_MANAGER:
// - Press temperature/pressure PLC log monitoring (Platen temp, dome/bladder pressure)
// - SKU-wise curing time cycle tracking (Seconds)
// - Curing bladder lifecycle management (shot counts and failure warnings)
//
model CuringVulcanizationLog {
  id                          String    @id @default(uuid())
  curingLogNumber             String    @unique // e.g. "VULC-2026-781"
  curingPressId               String    // e.g. "Press-Dome-08"
  cavityNumber                String    @default("LH") // LH, RH
  greenTyreBarcode            String    // Linked build barcode: "GT-2026-00892"
  curedTyreSerial             String    // Unique serial: "TYR-2026-04891"
  skuCode                     String    // e.g. "SKU-RAD-2055516"
  targetCureTimeSeconds       Int       // e.g. 780 seconds
  actualCureTimeSeconds       Int       // e.g. 782 seconds
