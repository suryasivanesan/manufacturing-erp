  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([logNumber])
  @@index([extrusionLineId])
  @@index([compoundType])
  @@map("insulation_sheathing_logs")
}

