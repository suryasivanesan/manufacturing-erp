  hidesCount                Int       // Number of crust sides/hides e.g. 120
  totalCrustAreaSqFt        Float     // Estimated batch area e.g. 5400.0 sq ft
  status                    String    @default("CRUST_APPROVED") // "IN_PROCESS", "CONDITIONING", "CRUST_APPROVED", "REWORK"
  technicianNotes           String?

  companyId                 String
  company                   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

