// 
// 1. BULLION_VAULT_SECURITY_MANAGER
// Core Functions:
// - Secure vault inventory management & dual-custody access logging
// - Inward/outward bullion weight tracking (fine grams/milligrams)
// - Daily metal balance reconciliation & physical vs ERP stock audit
// - Live metal market rate updates (Gold 24K/22K, Silver, Platinum) for real-time costing
//
model BullionVaultLedger {
  id                          String    @id @default(uuid())
  transactionCode             String    @unique // e.g. "BVL-2026-001"
  metalType                   String    // GOLD_24K, GOLD_22K, SILVER_999, PLATINUM_950
  movementType                String    // INWARD_PURCHASE, OUTWARD_CASTING, RECOVERY_RETURN, AUDIT_ADJUSTMENT
  grossWeightGrams            Float     // Gross weight in grams (e.g. 1000.500 g)
  purityPercentage            Float     // Purity % e.g. 99.90, 91.60
  netPureWeightGrams          Float     // Calculated net pure weight (e.g. 999.500 g)
  vaultLockerId               String    // e.g. "VAULT-A-LOCKER-04"
  liveMetalMarketRatePerGram  Float     // e.g. 7250.00 INR/g
  totalValuationInr           Float     // Calculated live asset valuation
  securityCustodianUser       String    // Custodian / Guard officer verifying balance
  dailyBalanceVerified        Boolean   @default(true)
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([transactionCode])
  @@index([metalType])
  @@index([movementType])
  @@map("bullion_vault_ledgers")
}

// 
// 2. CAD_CAM_PROTOTYPING_MANAGER
// Core Functions:
// - Digital 3D CAD design library & version control management
// - 3D printer resin and high-resolution castable wax consumption tracking
// - CAD digital master allocation to manufacturing work orders
// - Master rubber/silicone mold inventory & vulcanization cycle oversight
//
model CadCamPrototypingLog {
  id                          String    @id @default(uuid())
  designCode                  String    @unique // e.g. "CAD-DES-2026-104"
  designName                  String    // e.g. "Royal Kundan Peacock Choker"
  designCategory              String    // RING, NECKLACE, EARRINGS, BANGLE, BRACELET, PENDANT
  cadFileVersion              String    // e.g. "v3.2_final.3dm"
  cadFileStorageUrl           String?   // Secure CAD repository asset link
  manufacturingOrderNumber    String    // Associated Production Order e.g. "MO-JEW-2026-881"
  threeDPrinterId             String    // e.g. "ASIGA-MAX-UV-01"
  waxResinWeightGrams         Float     // Printed prototype weight in grams e.g. 4.85 g
  masterRubberMoldCode        String    // e.g. "MOLD-RBR-2026-552"
  expectedGoldWeight18kGrams  Float     // Theoretical converted gold weight 18K e.g. 62.40 g
  expectedGoldWeight22kGrams  Float     // Theoretical converted gold weight 22K e.g. 74.20 g
  status                      String    @default("APPROVED_FOR_CASTING") // DRAFT, SLICED, 3D_PRINTING, MOLD_PREPARED, APPROVED_FOR_CASTING, REJECTED
  designerNotes               String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([designCode])
  @@index([manufacturingOrderNumber])
  @@index([status])
  @@map("cad_cam_prototyping_logs")
}

// 
// 3. CASTING_MELTING_MANAGER
// Core Functions:
// - Karatage conversion recipe management & stoichiometric alloy calculations
// - Induction melting furnace cycle, vacuum pressure & temperature profile logging
// - Metal input vs output casting tree weight calculation & yield tracking
// - Crucible scrap recovery, sweepings/polishing dust recovery & unaccounted loss monitoring
//
model CastingMeltingCycle {
  id                          String    @id @default(uuid())
  castingTreeCode             String    @unique // e.g. "CAST-TREE-2026-042"
  furnaceId                   String    // e.g. "INDUCT-VAC-FURNACE-02"
  targetKaratage              String    // "22KT_916", "18KT_750", "14KT_585", "SILVER_925"
  pureGoldInputGrams          Float     // e.g. 458.000 g
  alloyMasterComposition      String    // e.g. "Cu-Ag-Zn Italian Red Alloy Master"
  alloyWeightGrams            Float     // e.g. 42.000 g
  totalInputWeightGrams       Float     // pure + alloy = 500.000 g
  meltingTempCelsius          Float     // Furnace melt temp e.g. 1045.0 °C
  vacuumPressureMbar          Float     // Vacuum chamber pressure e.g. 15.0 mbar
  castedTreeWeightGrams       Float     // Casted gold tree weight e.g. 491.200 g
  castingYieldPercentage      Float     // Yield % e.g. 98.24%
  crucibleScrapWeightGrams    Float     // Scrap remaining in crucible e.g. 6.800 g
  scrapDustRecoveryGrams      Float     // Recovered sprues/dust e.g. 1.450 g
  unaccountedLossGrams        Float     // Net unaccounted metallurgical loss e.g. 0.550 g
  castingStatus               String    @default("POURED_SUCCESSFUL") // SCHEDULED, MELTING, POURED_SUCCESSFUL, QUENCHED, SCRAP_RECOVERED, FAILED
  metallurgistNotes           String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([castingTreeCode])
  @@index([furnaceId])
  @@index([targetKaratage])
  @@map("casting_melting_cycles")
}

// 
// 4. GOLDSMITH_KARIGAR_MANAGER
// Core Functions:
// - Raw metal and gemstone issuance to internal/external karigars via job work challans
// - Detailed craftsmanship allocation (Filigree, Meenakari, Stone Setting, Jadau)
// - Net wastage reconciliation (Ghath/Touch loss vs permissible benchmark tolerance)
// - Artisan piece-rate / making charge settlement & wage accounting
//
model KarigarJobWork {
  id                          String    @id @default(uuid())
  challanNumber               String    @unique // e.g. "KRG-CHLN-2026-302"
  karigarName                 String    // e.g. "Rameshwar Sen (Master Artisan)"
  karigarType                 String    @default("INTERNAL") // INTERNAL, EXTERNAL_WORKSHOP
  workOrderNumber             String    // Associated Production Order e.g. "WO-JEW-2026-719"
  craftmanshipType            String    // FILIGREE, MEENAKARI, STONE_SETTING, JADAU, POLISHING
  issuedMetalWeightGrams      Float     // e.g. 84.500 g
  issuedMetalPurity           String    // "22KT_916", "18KT_750"
  issuedGemstonePieces        Int       @default(0) // e.g. 36 pcs
  issuedGemstoneCarats        Float     @default(0.0) // e.g. 12.40 cts
  receivedItemWeightGrams     Float     // e.g. 82.200 g
  returnedScrapDustGrams      Float     // Ghath recovery return e.g. 1.250 g
  allowedWastageGrams         Float     // Permissible benchmark tolerance e.g. 1.100 g
  actualWastageGrams          Float     // Issued - Received - Scrap = 84.5 - 82.2 - 1.25 = 1.050 g
  wastageVarianceGrams        Float     // Actual - Allowed = 1.050 - 1.100 = -0.050 g
  wastageStatus               String    @default("WITHIN_TOLERANCE") // WITHIN_TOLERANCE, EXCESS_LOSS_PENALIZED, RECONCILED
  karigarMakingChargesInr     Float     // Making charges / artisan remuneration
  paymentStatus               String    @default("PENDING_SETTLEMENT") // PENDING_SETTLEMENT, APPROVED, SETTLED
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([challanNumber])
  @@index([karigarName])
  @@index([workOrderNumber])
  @@index([wastageStatus])
  @@map("karigar_job_works")
}

// 
// 5. GEMSTONE_HALLMARKING_QC_MANAGER
// Core Functions:
// - Diamond and gemstone 4C grading & lab certificate recording (GIA/IGI/SGL)
// - BIS Hallmark laser engraving log tracking with mandatory 6-digit alphanumeric HUID
// - Final piece gross/net gold weight and XRF spectrometer purity verification
// - Certificate of Authenticity (CoA) issuance and dispatch quality clearance
//
model JewelleryHallmarkingQc {
  id                              String    @id @default(uuid())
  qcReportNumber                  String    @unique // e.g. "QC-JWL-2026-512"
  productSerialNumber             String    // Finished item barcode / SKU e.g. "JWL-SKU-2026-904"
  itemDescription                 String    // e.g. "22K Yellow Gold Solitaire Diamond Ring"
  grossWeightGrams                Float     // Total piece weight e.g. 8.420 g
  netGoldWeightGrams              Float     // Net gold weight excluding stones e.g. 7.980 g
  metalPurityTested               String    // e.g. "22KT_916"
  xrfSpectrometerPurityPct        Float     // Laboratory XRF test purity e.g. 91.68%
  diamondCaratWeight              Float?    // e.g. 0.72 ct
  diamondClarityGrade             String?   // e.g. "VVS1", "VS2", "SI1"
