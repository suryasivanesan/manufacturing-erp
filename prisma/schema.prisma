  stackVolumeCft                Float     // Volume in cubic feet e.g. 1250.0
  plankThicknessMm              Float     // e.g. 50.0 mm
  initialMoistureContentPct     Float     // Green moisture content e.g. 45.0%
  targetMoistureContentPct      Float     // Target EMC e.g. 7.5%
  currentMoistureContentPct     Float     // Current moisture e.g. 8.0%
  chamberTemperatureCelsius    Float     // Dry bulb temperature e.g. 62.0°C
