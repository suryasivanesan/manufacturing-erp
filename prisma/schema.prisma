  reflowZone1TempCelsius     Float     // e.g. 150.0 °C (Preheat Zone)
  reflowZone2TempCelsius     Float     // e.g. 190.0 °C (Soak Zone)
  reflowPeakTempCelsius      Float     // e.g. 245.5 °C (Peak Reflow Zone)
  conveyorSpeedMpm           Float     // e.g. 0.85 m/min
  dailyPcbOutputQty          Int       // e.g. 1200 boards
  passQty                    Int       // e.g. 1188 boards
  reworkQty                  Int       // e.g. 12 boards
  solderPasteType            String    @default("SAC305_LEAD_FREE") // SAC305_LEAD_FREE, SN63PB37, LOW_TEMP_BISMUTH
  status                     String    @default("REFLOW_OPTIMAL") // RUNNING, REFLOW_OPTIMAL, REFLOW_ALERT, COMPLETED
  notes                      String?

  companyId                  String
  company                    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([companyId])
  @@index([logCode])
  @@index([lineId])
  @@index([pcbBatchNumber])
  @@map("smt_pcb_assembly_logs")
}

// 
// 2. Electrical Testing, Calibration & Test Clearance Certificates
// Governed by ELECTRICAL_TESTING_CALIBRATION_MANAGER:
// - Automated test rig result recording
// - Uncalibrated test instrument blocking
// - Pass/fail defect log management
// - Electronic test clearance certificate issuance
//
model ElectricalTestingRecord {
  id                          String    @id @default(uuid())
  testReportNumber            String    @unique // e.g. "ETR-2026-9041"
  pcbOrDeviceSerial           String    // e.g. "SN-HW-2026-00491"
  testRigId                   String    // e.g. "RIG-ICT-FCT-03"
  voltageRangeVolts           Float     // e.g. 3.32 V
  currentConsumptionMilliAmps Float     // e.g. 142.5 mA
  frequencyMhz                Float?    // e.g. 48.00 MHz
  instrumentCalibrationCertId String    // e.g. "CAL-NABL-2026-8812"
  calibrationCertValidUntil   DateTime  // Expiry date of test rig calibration
  isInstrumentCalibrated      Boolean   @default(true)
  testResult                  String    @default("PASSED") // PASSED, FAILED, RETEST_REQUIRED, BLOCKED_UNCALIBRATED
  defectLog                   String?   // e.g. "Solder bridge pin 14 on U3, high quiescent current 220mA"
  clearanceCertificateNumber  String?   @unique // e.g. "COA-ELEC-2026-9041"
  certifiedAt                 DateTime?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([testReportNumber])
  @@index([pcbOrDeviceSerial])
  @@index([clearanceCertificateNumber])
  @@map("electrical_testing_records")
}

// 
// 3. Embedded Firmware Flashing & Serial Mapping
// Governed by FIRMWARE_FLASHING_MANAGER:
// - Firmware version master data management
// - Programming station API integration with ERP work orders
// - Strict 1-to-1 device serial number to flashed firmware mapping
//
model FirmwareFlashingLog {
  id                    String    @id @default(uuid())
  flashLogCode          String    @unique // e.g. "FWL-2026-4401"
  deviceSerialNumber    String    @unique // e.g. "DEV-IOT-2026-78210"
  macAddress            String?   // e.g. "AA:BB:CC:11:22:33"
  workOrderNumber       String    // e.g. "WO-ELEC-2026-081"
  firmwareName          String    // e.g. "Industrial-Gateway-Core"
  firmwareVersion       String    // e.g. "v2.4.12-secure-boot"
  checksumSha256        String    // e.g. "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
  flashStatus           String    @default("SUCCESS") // SUCCESS, FAILED, CHECKSUM_MISMATCH, RECOVERY_MODE
  flashingStationId     String    // e.g. "STN-PROG-BAY-02"
  flashedAt             DateTime  @default(now())
  operatorUsername      String?
  notes                 String?

  companyId             String
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId])
  @@index([flashLogCode])
  @@index([deviceSerialNumber])
  @@index([workOrderNumber])
  @@map("firmware_flashing_logs")
}

// 
// 4. Component Obsolescence & Engineering Bill of Materials (EBOM) Lifecycle
// Governed by COMPONENT_OBSOLESCENCE_EBOM_MANAGER:
// - Electronic component lifecycle status monitoring
// - Substitute component master list updates
// - Engineering Change Orders (ECO) handling
// - Vendor component lead time management
//
model ComponentEbomRecord {
  id                    String    @id @default(uuid())
  ebomCode              String    @unique // e.g. "EBOM-2026-MCU-STM32"
  assemblyPartNumber    String    // e.g. "ASSY-MAINBOARD-REV-C"
  componentPartNumber   String    // e.g. "STM32F407VGT6"
  componentCategory     String    // e.g. "Microcontroller / IC"
  lifecycleStatus       String    @default("ACTIVE") // ACTIVE, NRND_NOT_RECOMMENDED_FOR_NEW_DESIGNS, END_OF_LIFE, OBSOLETE
  substitutePartNumber  String?   // e.g. "GD32F407VGT6" (Pin-compatible substitute)
  substituteApproved    Boolean   @default(false)
  ecoNumber             String?   // e.g. "ECO-2026-019" (Engineering Change Order)
  ecoApprovedAt         DateTime?
  vendorName            String    // e.g. "STMicroelectronics / Arrow Electronics"
  leadTimeWeeks         Int       // e.g. 18 weeks
  unitCostInr           Float     // e.g. 640.00 INR
  notes                 String?

  companyId             String
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companyId])
  @@index([ebomCode])
  @@index([componentPartNumber])
  @@index([lifecycleStatus])
  @@map("component_ebom_records")
}

// 
// 5. Electrostatic Discharge (ESD) & Cleanroom Compliance
// Governed by ESD_CLEANROOM_COMPLIANCE_MANAGER:
// - Daily ESD workstation compliance audit logging
// - Grounding resistance test result tracking
// - Cleanroom environment sensor log monitoring
// - ESD-safe packaging material inventory oversight
//
model EsdCleanroomAuditLog {
  id                          String    @id @default(uuid())
  auditCode                   String    @unique // e.g. "ESD-AUDIT-2026-302"
  auditDate                   DateTime  @default(now())
  cleanroomZone               String    // e.g. "Zone-A-SMT-Cleanroom-Class-10000"
  workstationNumber           String    // e.g. "WS-SMT-04"
  wristStrapResistanceOhms    Float     // e.g. 850000 Ohms (Allowed: 750k - 10M Ohms)
  matGroundResistanceOhms     Float     // e.g. 2400000 Ohms (Allowed: 1M - 100M Ohms)
  relativeHumidityPct         Float     // e.g. 48.5% (Target: 40-60%)
  temperatureCelsius          Float     // e.g. 22.1 °C (Target: 20-24 °C)
  particleCountIsoClass       String    @default("ISO_CLASS_7") // ISO_CLASS_5, ISO_CLASS_6, ISO_CLASS_7, ISO_CLASS_8
  esdPackagingVerified        Boolean   @default(true) // Shielding bags & conductive bins verified
  auditStatus                 String    @default("COMPLIANT") // COMPLIANT, WARNING, NON_COMPLIANT
  auditedByRole               String    @default("ESD_CLEANROOM_COMPLIANCE_MANAGER")
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([auditCode])
  @@index([cleanroomZone])
  @@index([auditStatus])
  @@map("esd_cleanroom_audit_logs")
}

// =========================================================================
// ENGINEERING, MACHINERY AND ELECTRONICS - ELECTRIC EQUIPMENT INDUSTRY MODELS
// =========================================================================

// 
// 1. Coil Winding & Conductor Fabrication
// Governed by WINDING_COIL_FABRICATION_MANAGER:
// - Coil winding BOM management
// - Conductor weight consumption tracking
// - Winding machine counter log monitoring
// - Inter-turn insulation test data recording
//
model CoilWindingFabricationLog {
  id                          String    @id @default(uuid())
  windingLogCode              String    @unique // e.g. "WND-COIL-2026-101"
  workOrderNumber             String    // e.g. "WO-XFMR-2026-081"
  coilPartNumber              String    // e.g. "COIL-HV-33KV-A"
  transformerOrMotorRatingKva Float     // e.g. 2500.0 kVA
  wireGaugeSwgOrMm            String    // e.g. "SWG 14 Rectangular Strip (6.5 x 2.8 mm)"
  conductorMaterial           String    @default("COPPER") // COPPER, ALUMINUM
  conductorWeightKg           Float     // e.g. 184.5 kg
  calculatedTurnsTarget       Int       // e.g. 840 turns
  actualTurnsCount            Int       // e.g. 840 turns
  windingMachineCounterReading Int      // e.g. 14280
  interTurnSurgeTestVoltageKv Float     // e.g. 15.0 kV surge
  interTurnInsulationTestPassed Boolean @default(true)
  windingMachineId            String    // e.g. "Laxmi Automatic CNC Coil Winder CW-02"
  status                      String    @default("COMPLETED") // COMPLETED, IN_PROGRESS, REWORK_INSULATION
  operatorUsername            String?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([windingLogCode])
  @@index([workOrderNumber])
  @@index([coilPartNumber])
  @@index([status])
  @@map("coil_winding_fabrication_logs")
}

// 
// 2. Core Assembly & CRGO Lamination
// Governed by CORE_ASSEMBLY_LAMINATION_MANAGER:
// - CRGO sheet inventory and slitting dimension tracking
// - Core stacking schedule management
// - Core weight and clamping torque recording
// - No-load loss test metric logging
//
model CoreAssemblyLaminationLog {
  id                          String    @id @default(uuid())
  assemblyCode                String    @unique // e.g. "CORE-ASM-2026-201"
  coreBatchNumber             String    // e.g. "BATCH-CRGO-789"
  crgoGrade                   String    // e.g. "CRGO 23ZH90 / M4 High Permeability"
  slittingWidthMm             Float     // e.g. 220.0 mm
  crgoWeightKg                Float     // e.g. 1420.0 kg
  stackingScheduleId          String    // e.g. "SCHED-STK-V3"
  coreStepCount               Int       @default(7) // e.g. 7-step or 9-step mitered core
  stackingHeightMm            Float     // e.g. 485.0 mm
  clampingTorqueNm            Float     // e.g. 85.0 Nm tie-rod torque
  noLoadLossWattsPerKg        Float     // e.g. 0.82 W/kg at 1.7 Tesla
  totalNoLoadLossWatts        Float     // e.g. 1164.4 Watts
  insulationResistanceMOhms   Float     // e.g. 250.0 MegaOhms
  status                      String    @default("STACKED_APPROVED") // STACKED_APPROVED, TORQUE_RECHECK, QUARANTINED
  operatorUsername            String?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([assemblyCode])
  @@index([coreBatchNumber])
  @@index([crgoGrade])
  @@index([status])
  @@map("core_assembly_lamination_logs")
}

// 
// 3. Vacuum Pressure Impregnation (VPI) & Thermal Insulation
// Governed by VPI_INSULATION_MANAGER:
// - Oven temperature profile and vacuum pressure log monitoring
// - Resin/varnish bath specific gravity tracking
// - Drying cycle time management per equipment rating
//
model VpiInsulationProcessLog {
  id                          String    @id @default(uuid())
  vpiCycleCode                String    @unique // e.g. "VPI-CYC-2026-301"
  tankId                      String    // e.g. "VPI Chamber Autoclave Tank 1"
  batchNumber                 String    // e.g. "BATCH-VPI-XFMR-08"
  equipmentRatingKva          Float     // e.g. 2500.0 kVA
  preheatTempCelsius          Float     // e.g. 115.0 °C
  preheatDurationHours        Float     // e.g. 4.0 hours
  dryVacuumPressureMbar       Float     // e.g. 0.85 mbar
  vacuumDurationMinutes       Int       // e.g. 120 minutes
  resinBathTempCelsius        Float     // e.g. 32.5 °C
  varnishSpecificGravity      Float     // e.g. 1.085 g/cm³
  varnishViscositySec         Float     // e.g. 45.0 seconds (Ford Cup #4)
  impregnationPressureBar     Float     // e.g. 6.5 bar
  bakingTempCelsius           Float     // e.g. 140.0 °C
  bakingCycleHours            Float     // e.g. 10.5 hours
  insulationResistanceGigaOhms Float    // e.g. 15.2 GigaOhms
  vpiProcessStatus            String    @default("CYCLE_COMPLETED") // CYCLE_COMPLETED, IMPREGNATION_ACTIVE, BAKE_IN_PROGRESS, OUT_OF_SPEC_HOLD
  operatorUsername            String?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([vpiCycleCode])
  @@index([batchNumber])
  @@index([vpiProcessStatus])
  @@map("vpi_insulation_process_logs")
}

// 
// 4. High Voltage (HV) Routine Testing & Statutory Dispatch Certification
// Governed by HV_ROUTINE_TESTING_MANAGER:
// - Automated test rig data recording
// - Testing instrument calibration status verification
// - Uncertified unit blocking from dispatch
// - Test & Calibration Certificate auto-generation
//
model HvRoutineTestingRecord {
  id                          String    @id @default(uuid())
  testReportNumber            String    @unique // e.g. "HVR-2026-9041"
  unitSerialNumber            String    @unique // e.g. "TR-2500-2026-081"
  equipmentType               String    @default("POWER_TRANSFORMER") // POWER_TRANSFORMER, DISTRIBUTION_TRANSFORMER, MV_SWITCHGEAR, HT_INDUCTION_MOTOR
  ratedVoltageKv              Float     // e.g. 33.0 kV
  appliedHighVoltageKv        Float     // e.g. 70.0 kV power frequency withstand
  leakageCurrentMilliAmps     Float     // e.g. 4.2 mA
  insulationResistanceMegohms Float     // e.g. 4500.0 MOhm
  breakdownVoltageKv          Float?    // e.g. 85.0 kV (dielectric withstand)
  partialDischargePicoCoulombs Float    // e.g. 8.5 pC (limit: < 10 pC)
  isInstrumentCalibrated      Boolean   @default(true) // Test rig calibration lock
  calibrationCertId           String    // e.g. "NABL-CAL-HV-2026-104"
  calibrationValidUntil       DateTime  // Calibration expiry check
  dispatchBlocked             Boolean   @default(false) // Statutory gate lock: true if test fails or rig uncalibrated
  clearanceStatus             String    @default("PASSED_CERTIFIED") // PASSED_CERTIFIED, BLOCKED_UNCALIBRATED, FAILED_BREAKDOWN
  certificateNumber           String?   @unique // e.g. "CERT-HV-2026-0441"
  certifiedAt                 DateTime?
  certifiedByRole             String    @default("HV_ROUTINE_TESTING_MANAGER")
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([testReportNumber])
  @@index([unitSerialNumber])
  @@index([clearanceStatus])
  @@index([dispatchBlocked])
  @@map("hv_routine_testing_records")
}

// 
// 5. Busbar Fabrication & Enclosure Engineering
// Governed by BUSBAR_FABRICATION_ENCLOSURE_MANAGER:
// - Busbar length and bending specification tracking
// - Powder coating inventory management
// - Modular enclosure sub-assembly routing oversight
// - Clearance/creepage distance verification
//
model BusbarEnclosureFabricationLog {
  id                          String    @id @default(uuid())
  fabricationCode             String    @unique // e.g. "BUS-ENC-2026-501"
  enclosurePanelId            String    // e.g. "PNL-SWGR-11KV-BAY-03"
  busbarMaterial              String    @default("COPPER_ETP") // COPPER_ETP, ALUMINUM_EC
  busbarCrossSectionMm        String    // e.g. "100 x 10 mm Flat Bar"
  busbarCutLengthMm           Float     // e.g. 1850.0 mm
  bendAngleDegrees            Float     // e.g. 90.0°
  bendingRadiusMm             Float     // e.g. 20.0 mm
  phaseClearanceMm            Float     // e.g. 127.0 mm (Min required for 11kV: 120 mm)
  creepageDistanceMm          Float     // e.g. 220.0 mm (Min required for 11kV: 200 mm)
  clearanceCompliant          Boolean   @default(true) // Verified according to IEC 62271-200
  powderCoatingColorRal       String    @default("RAL 7035 Light Grey")
  dryFilmThicknessMicrons     Float     // e.g. 85.0 microns (Target: 70-100 um)
  powderBatchLotNumber        String    // e.g. "LOT-POWDER-EPX-774"
  assemblyRoutingStation      String    // e.g. "Modular Assembly Cell Stn-04"
  inspectionStatus            String    @default("APPROVED") // APPROVED, NON_COMPLIANT_CLEARANCE, COATING_REWORK
  inspectorUsername           String?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([fabricationCode])
  @@index([enclosurePanelId])
  @@index([inspectionStatus])
  @@map("busbar_enclosure_fabrication_logs")
}

// =========================================================================
// Core Enterprise Resource Planning & Super Admin Governance Models
// =========================================================================

// 
// Raw Materials Master Record
// Strictly scoped by companyId (Multi-Tenancy)
//
model RawMaterial {
  id              String    @id @default(uuid())
  materialCode    String    @unique // e.g. "RM-ST-001", "RM-CHEM-104", "RM-POLY-01"
  name            String    // e.g. "Direct Reduced Iron (DRI)", "Pure Acrylic Emulsion", "PVC Resin K-67"
  category        String    // e.g. "Metals", "Polymers", "Chemicals", "Pigments", "Packaging"
  costPrice       Float     @default(0.0) // Inward purchase cost per unit
  sellingPrice    Float     @default(0.0) // Standard baseline / resale valuation per unit
  unitPrice       Float     @default(0.0) // Active inward procurement rate per unit
  rate            Float     @default(0.0) // Active procurement rate per unit
  unit            String    // Measurement unit: MT, kg, m, ltr, Pcs
  currentStock    Float     @default(0.0)
  reorderLevel    Float     @default(10.0)
  supplierName    String?
  storageLocation String?   // e.g. "Silo-A1", "Bay-Chemical-03", "Yard-Scrap-02"
  notes           String?

  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productMappings ProductRawMaterial[]
  rateRequests    RawMaterialRateRequest[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([materialCode])
  @@index([category])
  @@map("raw_materials")
}

// 
// Products Master Catalog
// Strictly scoped by companyId (Multi-Tenancy)
//
model Product {
  id              String    @id @default(uuid())
  sku             String    @unique // e.g. "PRD-2055516-V3", "PRD-PIPE-110", "PRD-COIL-400"
  name            String    // e.g. "205/55 R16 Tubeless Radial", "110mm PVC Pressure Pipe PN10"
  category        String    // e.g. "Finished Goods", "Sub-Assemblies", "Commercial Stock"
  costPrice       Float     @default(0.0) // Manufacturing / conversion cost per unit (auto-calculated from raw materials)
  sellingPrice    Float     @default(0.0) // Customer catalog sales price per unit (configured by Super Admin)
  unit            String    // Measurement unit: MT, Pcs, m, ltr
  currentStock    Float     @default(0.0)
  minStockLevel   Float     @default(5.0)
  hsnCode         String?   // Statutory HSN/SAC code
  description     String?
  status          String    @default("ACTIVE") // ACTIVE, DISCONTINUED, UNDER_DEVELOPMENT

  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  rawMaterials    ProductRawMaterial[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([sku])
  @@index([category])
  @@map("products")
}

//
// Product <-> RawMaterial Mapping (Bill of Materials BOM)
// Strictly scoped by companyId (Multi-Tenancy)
// Used to auto-calculate Product costPrice from raw materials
//
model ProductRawMaterial {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterialId String
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  quantity      Float       @default(1.0) // Quantity of raw material consumed per 1 unit of Product
  scrapFactor   Float       @default(0.0) // Scrap / wastage percentage (e.g. 0.05 for 5%)
  notes         String?

  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([productId, rawMaterialId])
  @@index([companyId])
  @@index([productId])
  @@index([rawMaterialId])
  @@map("product_raw_materials")
}

//
// Raw Material Rate Change Request
// Submitted by Procurement, Approved/Rejected by Super Admin
// Strictly scoped by companyId (Multi-Tenancy)
//
model RawMaterialRateRequest {
  id                String      @id @default(uuid())
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rawMaterialId     String
  rawMaterial       RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  requestedByUserId String?
  currentRate       Float
  proposedRate      Float
  reason            String?
  status            String      @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rejectionReason   String?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([companyId])
  @@index([rawMaterialId])
  @@index([status])
  @@map("raw_material_rate_requests")
}

//
// In-App Notification System
// Strictly scoped by companyId & recipientRole (e.g. SUPER_ADMIN)
//
model Notification {
  id            String    @id @default(uuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipientRole String    @default("SUPER_ADMIN") // SUPER_ADMIN, PROCUREMENT, etc.
  title         String
  message       String
  type          String    // "RATE_CHANGE_REQUEST", "PRICING_UPDATE", "SYSTEM"
  referenceId   String?   // e.g. RawMaterialRateRequest id
  isRead        Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@index([recipientRole])
  @@index([isRead])
  @@map("notifications")
}

// 
// Employee Attendance, Payroll & Status Records
// Governed by Super Admin / HR (Attendance, Increments/Decrements, Hire/Terminate)
//
model EmployeePayroll {
  id               String    @id @default(uuid())
  month            String    // e.g. "2026-11"
  year             Int       @default(2026)
  baseSalary       Float     // Base monthly salary (INR / currency)
  increments       Float     @default(0.0) // Increments / performance bonus
  deductions       Float     @default(0.0) // Deductions / leave loss
  netSalary        Float     // Net payout = baseSalary + increments - deductions
  attendanceDays   Int       @default(26)  // Working days attended
  totalWorkingDays Int       @default(26)  // Total scheduled working days
  status           String    @default("ACTIVE") // ACTIVE, HIRE, TERMINATED
  paymentStatus    String    @default("PENDING") // PENDING, PAID, PROCESSED
  remarks          String?

  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([month])
  @@index([status])
  @@map("employee_payrolls")
}

// 
// Company Movement & Operational Audit Logs
// Governs enterprise movement tracking (Inventory inward/outward, RBAC updates, Payroll adjustments, Hire/Terminations)
//
model AuditLog {
  id              String    @id @default(uuid())
  action          String    // e.g. "PORTAL_ACCESS_GRANTED", "EMPLOYEE_TERMINATED", "INVENTORY_INWARD", "SALARY_INCREMENT_APPLIED"
  module          String    // "HR_PAYROLL", "INVENTORY", "RBAC", "PRODUCTION", "LOGISTICS"
  details         String    // JSON or descriptive audit trail
  movementType    String?   // "INWARD", "OUTWARD", "TRANSFER", "STATUS_CHANGE", "RBAC_CHANGE"
  performedByRole String    @default("SUPER_ADMIN")

  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())

  @@index([companyId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// 
// Super Admin Approval Workflow for Executive Draft Edits
// Status: PENDING | APPROVED | REJECTED
// Enforces company-level multi-tenancy isolation
//
model ApprovalRequest {
  id                  String    @id @default(uuid())
  requestNumber       String    @unique // e.g. "REQ-APPV-2026-001"
  entityType          String    // "RAW_MATERIAL", "PRODUCT", "PRODUCTION_ORDER", "PAYROLL_OVERRIDE"
  entityId            String?   // Target record ID (null if creation)
  actionType          String    // "CREATE", "UPDATE", "DELETE"
  title               String    // e.g. "Price Revision for Raw Steel Coil"
  description         String?   // Executive rationale for the change
  proposedChangesJson String    // JSON containing new/updated fields
  previousStateJson   String?   // JSON snapshot of data prior to proposed edit
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED
  
  requesterId         String
  requester           User      @relation("RequesterApprovals", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterRole       String    @default("EXECUTIVE")

  reviewerId          String?
  reviewer            User?     @relation("ReviewerApprovals", fields: [reviewerId], references: [id], onDelete: SetNull)
  rejectionReason     String?
  reviewedAt          DateTime?

  companyId           String
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([requesterId])
  @@index([entityType])
  @@index([createdAt])
  @@map("approval_requests")
}

