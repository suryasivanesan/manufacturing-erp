  meterMarkingAccuracyCalibrated    Boolean   @default(true) // Wheel encoder calibrated
  isQualityClearancePassed          Boolean   @default(true)
  dispatchBlocked                   Boolean   @default(false) // Interlocked if resistance high or spark fault > 0
