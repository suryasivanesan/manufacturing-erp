  fabricWeightKg              Float     // Total fabric weight in kg e.g. 240.0
  dyeRecipeCode               String    // e.g. "RECIPE-NAVY-BLUE-D65"
  dyestuffComponentsJson      String?   // Recipe chemicals e.g. '{"Reactive Blue 19": "2.4%", "Reactive Red 195": "0.6%", "Glauber Salt": "50 g/L"}'
