// 
// 2. Purchase Order Flow & Requisition Management
// Functions:
// - Purchase Requisition (PR) linking with Production Bill of Materials (BOM)
// - Raw material, consumable, and spare part PO generation
// - Commercial delivery & payment terms enforcement
// - Direct vendor dispatch and acknowledgment tracking
//
model PurchaseOrderFlow {
  id                          String    @id @default(uuid())
  poNumber                    String    @unique // e.g. "PO-2026-089"
  prNumber                    String    // Linked BOM PR e.g. "PR-BOM-2026-041"
  vendorName                  String
  vendorCode                  String?   // e.g. "VEND-TAT-01"
  orderCategory               String    // "RAW_MATERIALS", "SPARE_PARTS", "CONSUMABLES"
  itemDescription             String
  orderedQuantity             Float
  unit                        String    @default("MT")
  unitPrice                   Float
  taxRatePercentage           Float     @default(18.0)
  totalAmount                 Float
  deliveryTerms               String    @default("FOR_DESTINATION") // "EX_WORKS", "FOB", "CIF", "FOR_DESTINATION"
  paymentTerms                String    @default("NET_30") // "ADVANCE", "NET_30", "NET_60", "LC_AT_SIGHT"
  expectedDeliveryDate        DateTime
  dispatchStatus              String    @default("DISPATCHED_TO_VENDOR") // "DRAFT", "DISPATCHED_TO_VENDOR", "ACKNOWLEDGED_BY_VENDOR", "PARTIALLY_DELIVERED", "FULFILLED", "CANCELLED"
  approvedBy                  String?
  vendorAckDate               DateTime?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([poNumber])
  @@index([vendorName])
  @@index([dispatchStatus])
  @@map("purchase_order_flows")
}

// 
// 3. Material Inward, Gate-Entry & Quality Clearance Tracking
// Functions:
// - Transport fleet and carrier logistics coordination
// - Weighbridge gross/tare/net weight verification
// - Plant security gate entry pass synchronization
// - QC test clearance tracking and Goods Receipt Note (GRN) issuance
//
model MaterialInwardLogistics {
  id                          String    @id @default(uuid())
  inwardTrackingNumber        String    @unique // e.g. "INW-LOG-2026-401"
  poNumber                    String    // Reference to PurchaseOrderFlow
  vendorName                  String
  transporterName             String
  vehicleNumber               String
  driverContact               String?
  eWayBillNumber              String?
  challanInvoiceNumber        String
  gateEntryCode               String    // e.g. "GATE-IN-2026-881"
  weighbridgeGrossKg          Float
  weighbridgeTareKg           Float
  weighbridgeNetKg            Float
  unit                        String    @default("KG")
  qcInspectionStatus          String    @default("PENDING_LAB_TEST") // "PENDING_LAB_TEST", "UNDER_INSPECTION", "QC_PASSED", "QC_REJECTED", "CONDITIONAL_APPROVAL"
  qcTestReportNumber          String?
  grnNumber                   String?   // Generated Goods Receipt Note
  warehouseLocationBay        String?
  status                      String    @default("AT_GATE") // "EN_ROUTE", "AT_GATE", "WEIGHED", "UNLOADED", "GRN_GENERATED"
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([inwardTrackingNumber])
  @@index([poNumber])
  @@index([qcInspectionStatus])
  @@index([status])
  @@map("material_inward_logistics")
}

// 
// 4. Buffer Stock & Inventory Lead Time Planning
// Functions:
// - Minimum safety buffer stock vs maximum capacity thresholds
// - Dynamic reorder point triggers
// - Vendor supplier lead time tracking in days
// - Just-In-Time (JIT) delivery schedule automation
//
model BufferStockPlanning {
  id                          String    @id @default(uuid())
  itemCode                    String    @unique // e.g. "RM-STL-BIL-01"
  itemName                    String
  category                    String    // "RAW_MATERIALS", "SPARE_PARTS", "CONSUMABLES"
  unit                        String    @default("MT")
  currentStock                Float
  minimumBufferStock          Float
  maximumCapacityStock        Float
  reorderPoint                Float
  averageDailyConsumption     Float
  leadTimeDays                Int       @default(7)
  jitScheduleActive           Boolean   @default(true)
  jitDeliveryCadence          String?   // "DAILY_JIS", "BI_WEEKLY", "WEEKLY", "ON_CALL"
  stockStatus                 String    @default("HEALTHY") // "CRITICAL_LOW", "REORDER_TRIGGERED", "HEALTHY", "OVERSTOCKED"
  primaryVendorName           String?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([itemCode])
  @@index([stockStatus])
  @@map("buffer_stock_plannings")
}

// 
// 5. Vendor Performance Evaluation & Invoice Reconciliation
// Functions:
// - On-Time Delivery (OTD %) metrics
// - Defect rejection tracking and Debit Note generation
// - 3-Way matching across PO, GRN, and Supplier Invoice
// - Payment settlement clearance pipeline for Finance
//
model VendorReconciliation {
  id                          String    @id @default(uuid())
  reconciliationCode          String    @unique // e.g. "VEND-REC-2026-081"
  vendorName                  String
  poNumber                    String
  grnNumber                   String
  supplierInvoiceNumber       String
  invoiceAmount               Float
  grnReceivedAmount           Float
  discrepancyAmount           Float     @default(0.0)
  threeWayMatchStatus         String    @default("MATCHED") // "MATCHED", "DISCREPANCY_HOLD", "PRICE_VARIANCE", "QTY_VARIANCE"
  onTimeDeliveryScorePct      Float     @default(98.5)
  qualityPassRatePct          Float     @default(99.0)
  debitNoteNumber             String?   // e.g. "DN-2026-012"
  debitNoteAmount             Float?
  paymentSettlementStatus     String    @default("PENDING_FINANCE_RELEASE") // "PENDING_FINANCE_RELEASE", "APPROVED_FOR_PAYMENT", "SETTLED_PAID", "BLOCKED_ON_HOLD"
  settlementDueDate           DateTime?
  settledAt                   DateTime?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([reconciliationCode])
  @@index([vendorName])
  @@index([threeWayMatchStatus])
  @@index([paymentSettlementStatus])
  @@map("vendor_reconciliations")
}

// 
// 6. Scrap Yard Inventory & Surplus Material Disposal
// Functions:
// - Plant scrap yard inventory recording
// - Identification of surplus / non-moving raw materials
// - Scrap commercial tender generation and competitive bid evaluation
// - Waste-to-revenue tracking and outbound gate-pass generation
//
model ScrapDisposalManagement {
  id                          String    @id @default(uuid())
  disposalCode                String    @unique // e.g. "SCRAP-DISP-2026-021"
  scrapType                   String    // "FERROUS_HEAVY_MELTING_SCRAP", "ALUMINUM_TURNINGS_BORINGS", "COPPER_WIRE_ENDS", "PVC_POLYMER_REGIND", "PACKAGING_WOOD_CARDBOARD"
  storageYardLocation         String    // e.g. "YARD-SCRAP-BAY-03"
  accumulatedWeightKg         Float
  unit                        String    @default("KG")
  surplusMaterialOrigin       String?   // Origin line e.g. "Continuous Casting & Billet Cropping"
