  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([requisitionCode])
  @@index([department])
  @@index([status])
  @@map("hr_recruitment_records")
}

// 
// 2. Biometric Attendance & Shift Payroll Processing
// Functions:
// - Biometric / RFID smart punch card synchronization
// - Overtime (OT) hours and overtime pay rate computation
// - Shift allowances and night shift incentives
// - Monthly wage / salary processing with statutory deductions (PF, ESI, TDS)
//
model HrAttendancePayroll {
  id                          String    @id @default(uuid())
  recordCode                  String    @unique // e.g. "ATT-PAY-2026-11-001"
  employeeId                  String    // e.g. "EMP-PROD-012"
  employeeName                String    // e.g. "Rajesh Kumar"
  department                  String    // e.g. "PRODUCTION"
  shiftCode                   String    @default("GENERAL") // "GENERAL", "SHIFT_A_MORNING", "SHIFT_B_EVENING", "SHIFT_C_NIGHT"
  month                       String    // e.g. "2026-11"
  biometricPunchCardId        String?   // e.g. "RFID-88192"
  totalDaysPresent            Float     @default(26.0)
  totalDaysAbsent             Float     @default(0.0)
  totalPaidLeaves             Float     @default(2.0)
  overtimeHours               Float     @default(0.0)
  overtimePay                 Float     @default(0.0)
  shiftAllowance              Float     @default(0.0)
  nightShiftIncentive         Float     @default(0.0)
  baseGrossSalary             Float
  deductions                  Float     @default(0.0) // PF, ESI, Professional Tax, TDS
  netPayable                  Float
  paymentStatus               String    @default("PENDING") // "PENDING", "PROCESSED", "DISBURSED"
  disbursedAt                 DateTime?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([employeeId])
  @@index([month])
  @@index([department])
  @@index([paymentStatus])
  @@map("hr_attendance_payrolls")
}

// 
// 3. Statutory Compliance & Labor Law Governance
// Functions:
// - Provident Fund (PF / EPFO) and Employee State Insurance (ESI / ESIC) return tracking
// - Factory Act compliance checklists (safety exits, ventilation, creche, canteen)
// - Minimum Wages Act compliance verification
// - Annual bonus calculations & statutory registers
// - Labor union & worker committee meeting logs
//
model HrStatutoryCompliance {
  id                          String    @id @default(uuid())
  complianceCode              String    @unique // e.g. "STAT-COMP-2026-Q3-01"
  complianceType              String    // "PF_EPFO", "ESI_ESIC", "FACTORY_ACT", "MINIMUM_WAGES_ACT", "BONUS_ACT", "LABOR_COMMITTEE"
  period                      String    // e.g. "2026-10" or "2026-Q3"
  challanOrRefNumber          String?   // e.g. "EPFO-TRRN-9918274"
  totalCoveredEmployees       Int       @default(0)
  statutoryAmount             Float     @default(0.0)
  dueDate                     DateTime
  filingDate                  DateTime?
  complianceStatus            String    @default("PENDING") // "PENDING", "FILED", "VERIFIED_IN_SPEC", "AUDITED"
  minimumWageCompliant        Boolean   @default(true)
  factoryActChecklistJson     String?   // JSON checklist of statutory workplace norms
  unionMeetingMinutes         String?   // Committee meeting minutes & grievances discussed
  inspectorName               String?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([complianceType])
  @@index([period])
  @@index([complianceStatus])
  @@map("hr_statutory_compliances")
}

// 
// 4. Plant Safety, Welfare & EHS Administration
// Functions:
// - Personal Protective Equipment (PPE) kit issuance tracking (helmets, goggles, safety shoes)
// - Plant fire evacuation and safety drill schedules
// - Industrial canteen hygiene and worker meal management
// - First-aid center & occupational health examination logs
// - Drinking water, rest room, and worker welfare amenities
//
model HrSafetyWelfare {
  id                          String    @id @default(uuid())
  recordCode                  String    @unique // e.g. "SAFE-WEL-2026-001"
  category                    String    // "PPE_ISSUANCE", "SAFETY_DRILL", "CANTEEN_HYGIENE", "FIRST_AID_HEALTH", "WORKER_AMENITY"
  employeeId                  String?   // Optional for specific worker issuance/incident
  employeeName                String?
  department                  String?
  ppeItemsIssued              String?   // e.g. "Hard Hat (IS 2925), Heat-Resistant Kevlar Gloves, Steel Toe Boots"
  ppeBatchLot                 String?
  safetyDrillType             String?   // e.g. "Fire Evacuation & Chemical Spillage Drill"
  safetyDrillDate             DateTime?
  canteenInspectionScore      Float?    // Out of 100%
  firstAidIncidentType        String?   // e.g. "Minor index finger laceration treated with antiseptic dressing"
  welfareAmenityDetails       String?   // e.g. "RO water filtration TDS 110 ppm certified, rest room sanitized"
  status                      String    @default("ACTIVE") // "ACTIVE", "COMPLETED", "SCHEDULED", "INSPECTED"
  inspectorOrIssuer           String?
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([category])
  @@index([status])
  @@map("hr_safety_welfares")
}

// 
// 5. Training, Skill Development & Safety Induction
// Functions:
// - Mandatory safety induction for new plant hires
// - On-the-Job (OJT) mentorship and shopfloor competency evaluation
// - High-risk machinery operation certifications (cranes, CNC, boilers, press machines)
// - Lean manufacturing, 5S, and productivity incentive training
//
model HrTrainingCertification {
  id                          String    @id @default(uuid())
  trainingCode                String    @unique // e.g. "TRN-CERT-2026-101"
  trainingType                String    // "SAFETY_INDUCTION", "ON_THE_JOB_OJT", "MACHINE_CERTIFICATION", "PRODUCTIVITY_LEAN", "HAZMAT_HANDLING"
  courseTitle                 String    // e.g. "Overhead Crane & Heavy Rigging Operational Safety"
  trainerName                 String    // e.g. "Arun Sharma (Senior Safety Officer)"
  targetDepartment            String    // e.g. "PRODUCTION", "MAINTENANCE"
  attendeesCount              Int       @default(1)
  employeeId                  String?   // Optional individual trainee
  employeeName                String?
  certificationExpiry         DateTime?
  assessmentScorePct          Float?    // Out of 100%
  ojtMentorName               String?
  ojtCompletionStatus         String    @default("IN_PROGRESS") // "NOT_STARTED", "IN_PROGRESS", "CERTIFIED", "RE_TRAIN"
  validTill                   DateTime?
  status                      String    @default("ACTIVE") // "SCHEDULED", "ACTIVE", "COMPLETED", "EXPIRED"
  certificateIssued           Boolean   @default(false)
  notes                       String?

  companyId                   String
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([companyId])
  @@index([trainingType])
  @@index([status])
  @@map("hr_training_certifications")
}

